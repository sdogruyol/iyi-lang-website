---
/**
 * A block of the repository, set on a page of this site.
 *
 * `Quote` does this for README.md, against `src/generated/readme.json`. The
 * pages under /download/, /targets/ and /project/ lift from other files
 * (install.sh, the CI workflow, CONTRIBUTING.md), so their blocks arrive from
 * their own generators instead. What does not change is the rule: text that a
 * page shows in mono is text a generator read out of a file, travelling with
 * the lines it came from, and the citation is on the page rather than in a
 * tooltip.
 *
 * `.source` is the site's existing listing face, which also exempts the block
 * from scripts/prose.mjs: a listing is a token stream, not prose, and scanning
 * one for welded words hits on every line of it.
 */
interface Props {
  /** The text, exactly as the generator read it. */
  text: string;
  /** What the block is: a path, a command, a heading. */
  caption: string;
  /** Where it came from, with its line range. */
  cite: string;
  /** A link to the file, where the page has one. */
  href?: string;
}

const { text, caption, cite, href } = Astro.props;
---

<figure class="source lifted">
  <figcaption class="source-head">
    <span class="path">{caption}</span>
    <span>{href ? <a href={href}>{cite}</a> : cite}</span>
  </figcaption>
  <div class="scroll-x" role="region" tabindex="0" aria-label={`${caption}, quoted from ${cite}`}>
    <pre><code>{text}</code></pre>
  </div>
</figure>

<style>
  .lifted {
    margin-block: 0.6rem 1.4rem;
  }
</style>
