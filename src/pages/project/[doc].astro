---
/**
 * One of the repository's project documents, published whole.
 *
 * Every block is a block of the file, in the file's order, out of
 * src/generated/project.json. scripts/project.mjs proves the blocks reassemble
 * into the file byte for byte before it writes them, so this page cannot be
 * showing a document with a paragraph missing.
 *
 * Nothing is summarised, reordered or "adapted for the web". A security policy
 * a site paraphrases is a security policy that sends somebody's disclosure to
 * the wrong mailbox.
 */
import Page from "../../layouts/Page.astro";
import Lifted from "../tools/_Lifted.astro";
import project from "../../generated/project.json";

const base = import.meta.env.BASE_URL;

interface Block {
  kind: string;
  level?: number;
  html?: string;
  text?: string;
  lang?: string;
  ordered?: boolean;
  items?: string[];
  from: number;
  to: number;
}

interface Document {
  id: string;
  file: string;
  title: string;
  blurb: string;
  lines: number;
  cite: string;
  url: string;
  blocks: Block[];
}

export function getStaticPaths() {
  return project.documents.map((document) => ({
    params: { doc: document.id },
    props: { document },
  }));
}

const doc = Astro.props.document as unknown as Document;

/* The title is the document's own first heading and this page sets it as the
 * page heading, so it is not rendered twice. */
const body = doc.blocks.filter(
  (block, index) => !(index === 0 && block.kind === "heading" && block.level === 1),
);

const others = project.documents.filter((entry) => entry.id !== doc.id);
---

<Page
  kind="TechArticle"
  title={doc.title}
  summary={`${doc.blurb} Published verbatim from ${doc.file} in the iyi repository, ${doc.lines} lines, reassembled byte for byte at build time.`}
>
  <section class="wrap head">
    <p class="label">
      <a href={`${base}project/`}>Project</a>, verbatim
    </p>
    <h1>{doc.title}</h1>
    <p class="lede">{doc.blurb}</p>
    <dl class="evidence">
      <dt>this is</dt>
      <dd><a href={doc.url}>{doc.cite}</a>, published whole</dd>
      <dt>read at commit</dt>
      <dd>{project.provenance.commit}</dd>
    </dl>
  </section>

  <section class="wrap">
    <div class="prose">
      {body.map((block) => {
        if (block.kind === "heading") {
          /* A comparison with `<` inside the template is read as the start of
           * a tag by Astro's parser, so the level picks its element here and
           * the element is rendered by name. The document's own h1 is the page
           * heading, so everything below it moves down one. */
          const Heading = block.level === 3 ? "h3" : block.level === 4 ? "h4" : "h2";
          return <Heading set:html={block.html ?? ""} />;
        }
        if (block.kind === "paragraph") return <p set:html={block.html ?? ""} />;
        if (block.kind === "list") {
          return block.ordered ? (
            <ol>{(block.items ?? []).map((item) => <li set:html={item} />)}</ol>
          ) : (
            <ul>{(block.items ?? []).map((item) => <li set:html={item} />)}</ul>
          );
        }
        if (block.kind === "code") {
          return (
            <Lifted
              text={block.text ?? ""}
              caption={doc.file}
              cite={`${doc.file}, lines ${block.from} to ${block.to}`}
              href={doc.url}
            />
          );
        }
        if (block.kind === "rule") return <hr class="rule" />;
        /* A link definition block and an HTML comment render as nothing: they
         * are the document's plumbing, already resolved into the links above,
         * and printing them would be printing markdown at a reader. */
        return null;
      })}
    </div>
  </section>

  <section class="wrap next">
    <h2>The rest</h2>
    <ul class="others">
      {others.map((entry) => (
        <li>
          <a href={`${base}project/${entry.id}/`}>{entry.title}</a>
          <span>{entry.blurb}</span>
        </li>
      ))}
    </ul>
    <dl class="evidence">
      <dt>generated by</dt>
      <dd>{project.provenance.generator}</dd>
      <dt>from</dt>
      <dd>{project.provenance.repository}, at {project.provenance.commit}</dd>
    </dl>
  </section>

  <style>
    section {
      padding-block: clamp(1.2rem, 2.5vw, 2rem);
    }

    .head {
      padding-block-start: clamp(2.5rem, 5vw, 4rem);
    }

    .head h1 {
      font-size: var(--step-3);
      margin-block: 0.5rem 0.8rem;
    }

    .lede {
      color: var(--graphite);
      max-width: 62ch;
    }

    .prose {
      max-width: 68ch;
    }

    .next h2 {
      font-size: var(--step-1);
      margin-block-end: 0.6rem;
    }

    .others {
      list-style: none;
      margin: 0 0 1.4rem;
      padding: 0;
      display: grid;
      gap: 0.5rem;
      max-width: 62ch;
    }

    .others li {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 0.9rem;
      align-items: baseline;
      padding-block-end: 0.5rem;
      border-block-end: var(--hair) solid var(--hairline);
      color: var(--graphite);
      font-size: var(--step--1);
    }

    .next {
      padding-block-end: 3rem;
    }
  </style>
</Page>
