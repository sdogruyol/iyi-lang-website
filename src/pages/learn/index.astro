---
/**
 * The path.
 *
 * Not a card grid and not a directory listing: a numbered walk with one
 * starting point, where reading step three assumes you read step two. The step
 * number is the `order` in the lesson's own frontmatter, checked by
 * src/lib/lessons.ts to be unique and gapless, so the number on this page is
 * the number in the file.
 *
 * The rule each step teaches is named beside it, carrying SPEC.md's own
 * sentence, read out of SPEC.md's rule table and its section headings by
 * scripts/samples.mjs. The rejection each step ends on is named too, carrying
 * the title of a case in records/diagnostics.json, so the index cannot
 * promise a recorded diagnostic that nobody ran.
 *
 * There are two tracks and this page shows both, because the rules are not the
 * syntax and a reader arrives wanting one or the other. The second is the
 * tour, which lives under /playground/: its sections and its steps are read
 * out of samples/tour/tour.json through src/playground/samples.ts, resolved
 * against the wasm recording there, so a step this page offers is a step that
 * has a page and a recorded run.
 */
import Measure from "../../components/Measure.astro";
import Page from "../../layouts/Page.astro";
import {
  sequence,
  rulesOf,
  breakCases,
  inlineMarkdown,
  lessonHref,
  SPELLED,
} from "../../lib/lessons";
import {
  playgroundHref,
  runnable,
  tourSamples,
  tourSections,
} from "../../playground/samples";
import { recordedText } from "../../lib/highlight";

const lessons = await sequence();
const base = import.meta.env.BASE_URL;
const playground = `${base.replace(/\/$/, "")}/playground/`;

const steps = lessons.map((lesson, i) => ({
  lesson,
  href: lessonHref(base, lesson),
  rules: rulesOf(lesson),
  broken: breakCases(lesson),
  next: lessons[i + 1],
}));

const [first] = steps;
const spelled = SPELLED[steps.length] ?? String(steps.length);
const count = `${spelled[0].toUpperCase()}${spelled.slice(1)}`;

// The other track. Every step carries its own page under /playground/, so the
// href is the recording's, not a guess: `playgroundHref` answers null for a
// program the wasm record does not cover, and a section that lost a step to
// that would be offering a link to nothing, so it is a build failure here.
const tour = tourSections.map((section) => ({
  title: section.title,
  blurb: section.blurb,
  steps: section.steps.map((step) => {
    const href = playgroundHref(step.id) ?? `${playground}${step.id}/`;
    return { id: step.id, href, runs: runnable(step) };
  }),
}));

const tourStart = tour[0]?.steps[0];
if (tourStart === undefined) {
  throw new Error(
    "samples/tour/tour.json laid out no sections, so this page would offer a " +
      "second track with no way into it",
  );
}

// A program's own opening sentence, read out of the highlight recording rather
// than described here, so a sample that changes what it documents changes this
// page with it. The leading comment block is joined before the sentence is cut,
// because a comment wraps at the file's column and a first line is a fragment
// as often as it is a sentence: webapp.iyi's runs onto its second line, and
// showing only the first left the page ending on "injected by".
function opening(path: string): string {
  const lines: string[] = [];
  for (const line of recordedText(path).split("\n")) {
    const comment = /^#\s?(.*)$/.exec(line);
    if (comment === null) break;
    if (comment[1].trim() === "") break;
    lines.push(comment[1].trim());
  }
  const joined = lines.join(" ");
  const stop = joined.indexOf(". ");
  const sentence = stop === -1 ? joined : joined.slice(0, stop + 1);
  if (sentence === "") {
    throw new Error(
      `${path} opens with no comment, so this page has nothing to say about ` +
        `it that the file says itself. Describe it in the file, not here.`,
    );
  }
  return sentence;
}

// The samples a lesson does not stand on, each linked where it can be run.
// Named here rather than in a paragraph so the page cannot offer a program the
// recording has no module for, which is how the old closing paragraph sent a
// reader to a directory listing that does not exist on this site.
const grounded = new Set(lessons.map((lesson) => lesson.data.sample));
const further = [
  "samples/iyi/collections.iyi",
  "samples/iyi/immutable.iyi",
  "samples/iyi/init_order.iyi",
  "samples/iyi/webapp.iyi",
]
  .filter((path) => !grounded.has(path))
  .map((path) => {
    const href = playgroundHref(path);
    if (href === null) {
      throw new Error(
        `this page offers ${path} as somewhere to go next and the wasm ` +
          `recording has no module for it, so the link would not run. Either ` +
          `record it or name a different sample.`,
      );
    }
    return { name: path.replace(/^samples\/iyi\//, ""), href, blurb: opening(path) };
  });
---

<Page
  kind="CollectionPage"
  title="Learn iyi"
  summary={`${count} steps in order, one rule each. Compile against declarations rather than bodies, write down what you export, own your own names, replace open classes with traits, type a body where it is written, cross a boundary with a generic, keep a macro to one declaration, and return errors as ordinary values.`}
>
  <div class="spread">
    <div class="intro">
      <p class="label">Learn</p>
      <h1>{count} steps, one rule each</h1>
      <p class="lede">
        iyi is Crystal with one rule added, and that rule changes enough that
        starting from the syntax would teach you the wrong thing. So these
        steps start from the rule, in the order the rules depend on each other.
      </p>
      <p>
        Each step opens with the rule in the specification's own words, shows
        the program it is grounded in, breaks the rule on purpose, and prints
        what the compiler said. Every listing is read out of the repository
        when the page is built, and every error is a recording of a real run.
      </p>
      <p class="start">
        <a href={first.href}>Start at step one, {first.lesson.data.title}</a>
      </p>
      <p class="sideways">
        Or start with the syntax. <a href={tourStart.href}>The tour</a> is{" "}
        {tourSamples.length} short programs that run in your browser, from one{" "}
        <code>puts</code> to tasks and channels, and it is the second track at
        the foot of this page.
      </p>
    </div>

    <dl class="evidence to-rail chain">
      <dt>the path</dt>
      {
        steps.map(({ lesson, rules }) => (
          <dd>
            <span class="chain-step">{lesson.data.order}</span>
            <span class="chain-rule">{rules.map((rule) => rule.id).join(" ")}</span>
          </dd>
        ))
      }
      <dd class="chain-note">
        Each identifier is the specification's own, and the sentence it states
        for it is beside the step.
      </dd>
    </dl>
  </div>

  <ol class="sequence">
    {
      steps.map(({ lesson, href, rules, broken, next }) => (
        <li class="spread step">
          <hr class="rule to-wide" />

          <div class="step-body">
            <p class="label step-index">
              Step {lesson.data.order} of {steps.length}
              {lesson.data.order === 1 && <span class="here">start here</span>}
            </p>
            <ol class="ticks" aria-hidden="true">
              {steps.map(({ lesson: other }) => (
                <li
                  class:list={[
                    "tick",
                    {
                      done: other.data.order < lesson.data.order,
                      here: other.data.order === lesson.data.order,
                    },
                  ]}
                />
              ))}
            </ol>
            <h2>
              <a href={href}>{lesson.data.title}</a>
            </h2>
            <p class="step-summary" set:html={inlineMarkdown(lesson.data.summary)} />
            <p class="step-onward">
              {
                next ? (
                  <>
                    Then step {next.data.order}, <a href={lessonHref(base, next)}>{next.data.title}</a>.
                  </>
                ) : (
                  <>The last step. After it, the tour below is the syntax.</>
                )
              }
            </p>
          </div>

          <dl class="evidence to-rail">
            <dt>teaches</dt>
            {rules.map((rule) => (
              <dd>
                <span class="rule-id">{rule.id}</span>
                <span class="premise" set:html={inlineMarkdown(rule.premise)} />
              </dd>
            ))}
            <dt>grounded in</dt>
            <dd>{lesson.data.sample}</dd>
            <dt>breaks</dt>
            {broken.map((entry) => (
              <dd class="breaks">{entry.title}</dd>
            ))}
          </dl>
        </li>
      ))
    }
  </ol>

  <div class="spread">
    <section class="after to-wide">
      <hr class="rule" />
      <p class="label">The second track</p>
      <h2 class="after-head">The syntax, in {tourSamples.length} short programs</h2>
      <p class="after-body">
        The steps above are the rules, which is what makes iyi a different
        language from the one it forked. The tour is everything else: the
        syntax, in the order a person learns a language, each step a program
        that runs in your browser from the module the compiler built for it.
        Read the rules first and the tour reads as confirmation. Read the tour
        first and the rules read as the reason.
      </p>

      <ol class="tour">
        {
          tour.map((section) => (
            <li class="tour-section">
              <p class="tour-title">{section.title}</p>
              <p class="tour-blurb">{section.blurb}</p>
              <p class="tour-steps">
                {section.steps.map((step) => (
                  <a class:list={["tour-step", { recorded: !step.runs }]} href={step.href}>
                    {step.id}
                  </a>
                ))}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="after-note">
        A step set in the quieter face ran natively rather than in the browser:
        tasks and channels have no wasm target yet, so those two pages show
        what the program printed on the machine the recording names.
      </p>
    </section>

    <section class="after to-wide">
      <hr class="rule" />
      <p class="label">And the rest of the samples</p>
      <p class="after-body">
        Neither track is the whole repository. <code>samples/iyi</code> holds{" "}
        <Measure of="samples" /> programs, each written to document a part of
        the design rather than to show off. The ones no step above is grounded
        in are the ones to read next, and each of them runs here too:
      </p>
      <ul class="further">
        {
          further.map((sample) => (
            <li>
              <a href={sample.href}><code>{sample.name}</code></a>
              <span class="further-blurb">{sample.blurb}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Page>

<style>
  .intro {
    padding-block: 3.2rem 0.6rem;
  }

  .intro h1 {
    margin-block: 0.5rem 1.1rem;
  }

  .lede {
    font-size: var(--step-1);
    line-height: var(--lead-snug);
    color: var(--graphite);
  }

  /* The one obvious way in. A path with no marked entrance is a directory. */
  .start {
    margin-block: 1.6rem 0;
    font-size: var(--step-1);
  }

  .start a {
    text-decoration: none;
    border-bottom: 2px solid var(--signal);
    padding-block-end: 2px;
  }

  /* The whole walk in the rail: the step numbers and the rule each one takes,
   * in order, so the shape of the path is legible before any of it is read. */
  .chain {
    padding-block-start: 3.9rem;
  }

  .chain dd {
    display: flex;
    gap: 0.7rem;
    margin-block-end: 0.3rem;
  }

  .chain-step {
    color: var(--mute);
  }

  .chain-rule {
    color: var(--ink);
    font-weight: 600;
  }

  .chain dt + dt,
  .chain dd + dt {
    margin-block-start: 1.1rem;
  }

  .chain-note {
    color: var(--graphite);
  }

  .sequence {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* `.spread` makes each step a grid, so the marker is gone and the number is
   * rendered instead. That is deliberate: the number is content here, taken
   * from the lesson's frontmatter, not a browser's list decoration. */
  .step {
    padding-block-end: 0.4rem;
  }

  .step > .rule {
    margin-block: 2.4rem 1.5rem;
  }

  .step-index {
    margin: 0 0 0.45rem;
  }

  /* The entrance, marked in the one colour this site spends on a caveat, used
   * here for the one thing a reader has to see first. */
  .here {
    color: var(--signal);
    margin-inline-start: 0.7rem;
  }

  /* Position in the path, drawn as instrument ticks. Structural: it is the
   * `order` in the file, and it is not a claim about what has been read. */
  .ticks {
    display: flex;
    gap: 0.32rem;
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .tick {
    width: 1.6rem;
    height: var(--hair);
    background: var(--track);
  }

  .tick.done {
    background: var(--hairline);
  }

  .tick.here {
    height: 3px;
    background: var(--ink);
  }

  .step h2 {
    font-size: var(--step-2);
    margin-block-end: 0.55rem;
  }

  .step h2 a {
    text-decoration: none;
    border-bottom: var(--hair) solid var(--hairline);
    padding-block-end: 1px;
  }

  .step h2 a:hover {
    border-bottom-color: var(--signal);
  }

  .step-summary {
    max-width: 58ch;
    color: var(--graphite);
    margin-block-end: 0;
  }

  /* Each step hands off to the next here as well as at the foot of the lesson,
   * because the index is where a reader decides whether this is a path. */
  .step-onward {
    margin-block: 0.9rem 0;
    max-width: 58ch;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--mute);
  }

  .step-onward a {
    color: var(--graphite);
  }

  .step .evidence {
    margin-block: 0.35rem 0;
  }

  .rule-id {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  .premise {
    display: block;
  }

  .breaks {
    color: var(--signal-deep);
  }

  @media (max-width: 62rem) {
    .chain {
      padding-block-start: 1.6rem;
    }

    .step .evidence {
      margin-block-start: 1.1rem;
    }
  }

  /* The other way in, under the one obvious way in. Quieter than `.start`,
   * because a reader who wants the rules should not have to choose twice. */
  .sideways {
    margin-block: 1.1rem 0;
    max-width: 58ch;
    color: var(--graphite);
  }

  /* The end of the path. A walk should say where it goes next, and the answer
   * is the other track rather than a directory this site does not publish. */
  .after {
    margin-block: 3rem 1rem;
  }

  .after .label {
    margin-block: 1.3rem 0.8rem;
  }

  .after-head {
    font-size: var(--step-2);
    margin-block: 0 0.9rem;
  }

  .after-body {
    margin: 0;
    max-width: var(--measure);
    color: var(--graphite);
  }

  /* The tour, by section. A section is a row: what it covers, then its steps
   * as the names of the programs, because the program's name is what a reader
   * will be looking at on the page it links to. */
  .tour {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .tour-section + .tour-section {
    margin-block-start: 1.6rem;
    border-top: var(--hair) solid var(--track);
    padding-block-start: 1.6rem;
  }

  .tour-title {
    margin: 0;
    font-weight: 600;
  }

  .tour-blurb {
    margin: 0.25rem 0 0;
    max-width: var(--measure);
    color: var(--graphite);
  }

  .tour-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .tour-step {
    color: var(--graphite);
    text-decoration: none;
    border-bottom: var(--hair) solid var(--hairline);
    padding-block-end: 1px;
  }

  .tour-step:hover,
  .tour-step:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  /* A step the browser's target cannot run. Set quieter rather than marked
   * with a badge: the page says what it means once, under the list. */
  .tour-step.recorded {
    color: var(--mute);
    border-bottom-style: dotted;
  }

  .after-note {
    margin-block: 1.4rem 0;
    max-width: var(--measure);
    font-size: var(--step--1);
    color: var(--mute);
  }

  .further {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .further li {
    display: grid;
    /* The floor is the longest sample name plus room, so a name never breaks
     * mid-token and the blurbs line up as a column a reader can scan. */
    grid-template-columns: minmax(0, 16ch) minmax(0, 1fr);
    gap: 0.2rem var(--gutter);
    align-items: baseline;
  }

  .further a {
    text-decoration: none;
    border-bottom: var(--hair) solid var(--hairline);
    padding-block-end: 1px;
  }

  .further a:hover {
    border-bottom-color: var(--signal);
  }

  .further-blurb {
    color: var(--graphite);
  }

  @media (max-width: 42rem) {
    .further li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
