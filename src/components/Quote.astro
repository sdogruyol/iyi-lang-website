---
/**
 * A verbatim recording quoted out of README.md.
 *
 * `scripts/samples.mjs` finds the block by an anchor string that has to match
 * exactly one fenced block in the whole README, and carries the line numbers it
 * came from. Nothing here retypes output. A page that invented a terminal
 * session would be the same failure as a page that invented a number.
 *
 * Three faces. Two are already styled in styles/code.css and classified by
 * src/lib/recording.ts, which BreakRule shares so that a caret line means the
 * same thing wherever a recording is set:
 *
 *   console     a recording of a real run. Prompts and commands are marked,
 *               output is not, because nothing highlighted it in the terminal.
 *   diagnostic  a compiler error. iyi's errors name the rule they enforce,
 *               which is a feature, so this is a designed component rather
 *               than a red box, and the caret line is preserved exactly.
 *   source      a listing README.md shows and this site has no recording of,
 *               set in plain ink, because colouring comes from the compiler's
 *               lexer or not at all. `caption` is the path the listing is of.
 */
import readme from "../generated/readme.json";
import { renderRecording } from "../lib/recording";

interface Props {
  id: string;
  as?: "console" | "diagnostic" | "source";
  caption?: string;
  /** On a console face: a control that copies the commands, without their
   * prompts and without the output, so what lands in a shell is what the
   * recording ran. */
  copy?: boolean;
}

const { id, as = "console", caption, copy = false } = Astro.props;

type Block = { text: string; from: number; to: number; source: string; cite: string };

const block = (readme as Record<string, Block>)[id];

if (!block) {
  throw new Error(
    `Quote: "${id}" is not a recording scripts/samples.mjs extracts. It has ` +
      `${Object.keys(readme).join(", ")}. Add an anchor to WANTED in that ` +
      `script rather than typing the output into a page.`,
  );
}

const body = as === "source" ? null : renderRecording(block.text, as);

/* The commands alone: the lines the recording ran, with the prompt stripped.
 * Taken from the text, not the markup, so the copy cannot pick up a span. */
const commands = block.text
  .split("\n")
  .filter((line) => line.startsWith("$ "))
  .map((line) => line.slice(2))
  .join("\n");
---

{
  as === "console" ? (
    <div class="console">
      <div class="console-chrome">
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <span class="caption">{caption ?? `quoted from ${block.cite}`}</span>
        {copy && (
          <button type="button" class="copy" data-copy={commands} aria-label="Copy the commands">
            Copy
          </button>
        )}
      </div>
      <pre set:html={body} />
    </div>
  ) : as === "diagnostic" ? (
    <div class="diagnostic">
      <pre set:html={body} />
      <span class="cites">
        {caption ? `${caption}. ` : ""}Quoted verbatim from {block.cite}.
      </span>
    </div>
  ) : (
    <figure class="source">
      <figcaption class="source-head">
        <span class="path">{caption}</span>
        <span>quoted from {block.cite}</span>
      </figcaption>
      <pre><code>{block.text}</code></pre>
    </figure>
  )
}

{
  copy && (
    <script>
      /* One listener for every copy control on the page. The button carries
       * the text it copies, so the script reads nothing off the rendered
       * recording. The async clipboard needs a secure context and a permission
       * some browsers withhold; the fallback is the old selection-and-copy
       * through a scratch textarea, which works everywhere a user gesture is
       * in flight. */
      const copyText = async (text: string): Promise<boolean> => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const scratch = document.createElement("textarea");
          scratch.value = text;
          scratch.setAttribute("readonly", "");
          scratch.style.position = "fixed";
          scratch.style.opacity = "0";
          document.body.appendChild(scratch);
          scratch.select();
          let ok = false;
          try {
            ok = document.execCommand("copy");
          } catch {
            ok = false;
          }
          scratch.remove();
          return ok;
        }
      };

      for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy[data-copy]")) {
        button.addEventListener("click", async () => {
          const ok = await copyText(button.dataset.copy ?? "");
          button.textContent = ok ? "Copied" : "Could not copy";
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        });
      }
    </script>
  )
}

<style>
  .copy {
    margin-inline-start: auto;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--graphite);
    background: var(--paper);
    border: var(--hair) solid var(--hairline);
    border-radius: 6px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--ink);
    border-color: var(--graphite);
  }
</style>
