---
/**
 * One recorded program, and a run that really runs it.
 *
 * The page is a program on the left, its output on the right, and a run
 * control between them. The module the compiler built from this file is
 * fetched, digest checked against the record, and executed in the visitor's
 * own tab against the WASI host in `src/playground/engines/wasi-preview1.ts`.
 *
 * Everything about compiling and running iyi arrives through one interface,
 * `PlaygroundEngine` (src/playground/types.ts), resolved in one place,
 * `activeEngine()` (src/playground/registry.ts). This component is built once
 * in node and once as a page in a browser, and it renders the same interface
 * on both sides, so nothing here is conditional on the browser existing.
 *
 * Three rules, each a consequence of the site's own argument.
 *
 * 1. THE PAGE NEVER RENDERS OUTPUT NOTHING PRODUCED. No spinner that never
 *    resolves, no synthesised exit status, no output attributed to a program
 *    that did not run.
 *
 * 2. THE RUN IS PRECOMPILED, AND THE PAGE SAYS SO IN ONE LINE. Nothing here
 *    compiles. The pane is editable so a reader can move around in the
 *    program, and the moment the text stops being the recorded text the run
 *    control renames itself and the line under the pane says which bytes will
 *    execute.
 *
 * 3. COLOURING COMES FROM THE COMPILER'S LEXER OR IT DOES NOT COME AT ALL.
 *    Recorded for this file, plain ink for anything typed over it.
 */
import { activeEngine } from "../playground/registry";
import type { Capability } from "../playground/types";
import type { CuratedSample } from "../playground/samples";
import { curatedSamples, playgroundHref } from "../playground/samples";
import { highlightedLines, recordedText } from "../lib/highlight";

interface Props {
  /** The curated sample this route carries. */
  sample: CuratedSample;
}

const { sample } = Astro.props;

const engine = activeEngine();
const caps = engine.capabilities();
const supports = (cap: Capability) => caps.supported.includes(cap);

/* The program and its colouring, both out of the records and both read here at
 * build time, which keeps the quarter of a megabyte of listings in
 * `records/highlight.json` out of the client bundle. */
const source = recordedText(sample.path);
const inkLines = highlightedLines(sample.path);

/* Every sample opens with a comment saying what it is. That line is the page's
 * one sentence about the program, so the description cannot drift from the
 * file. */
const blurb = source.split("\n")[0].replace(/^#\s*/, "").replace(/\.$/, "");

/* The HTML parser drops one newline immediately after a `<textarea>` open tag
 * and after a `<pre>` open tag. Every sample begins with a comment, so this
 * costs nothing today; it is here so that a program beginning with a blank line
 * does not silently lose it and shift every line number by one. */
const seed = source.startsWith("\n") ? `\n${source}` : source;
const ink = inkLines.join("\n");
const seedInk = ink.startsWith("\n") ? `\n${ink}` : ink;

const editable = caps.maxSourceBytes > 0;
const base = import.meta.env.BASE_URL.replace(/\/*$/, "/");

/* Previous and next in the recorder's order, so the samples read as a tour. */
const at = curatedSamples.findIndex((entry) => entry.id === sample.id);
const prev = at > 0 ? curatedSamples[at - 1] : null;
const next = at < curatedSamples.length - 1 ? curatedSamples[at + 1] : null;
---

<section class="bench wrap" aria-label="Run a recorded program">
  <div class="bench-head">
    <div class="bench-title">
      <p class="label"><a href={`${base}playground/`}>Playground</a></p>
      <h1>{sample.id}</h1>
      <p class="pitch">{blurb}.</p>
    </div>

    <div class="bar">
      <button
        type="button"
        class="cta run"
        data-control="run"
        data-label="Run"
        data-label-stale="Run recorded"
        disabled={supports("run") && editable ? undefined : true}
      >
        <span class="run-label">Run</span>
        <span class="chord">Ctrl + Enter</span>
      </button>
      <button type="button" class="cta ghost" data-role="reset" hidden={true}>
        Reset
      </button>
      <button type="button" class="cta ghost" data-role="cancel" hidden={true}>
        Stop
      </button>

      {/* Links, not a select. Each sample is a real URL that resolves before
          any script runs, so a lesson's deep link works with scripts off and
          survives being bookmarked. */}
      <details class="menu">
        <summary class="cta ghost">Samples</summary>
        <ul class="menu-body">
          {
            curatedSamples.map((entry) => (
              <li>
                <a
                  href={playgroundHref(entry.id)}
                  class="pick"
                  aria-current={entry.id === sample.id ? "page" : undefined}
                >
                  {entry.id}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>

  {/* Editor first in source order, which is also the order the panes stack in
      below the breakpoint, so the program is what a narrow screen shows first. */}
  <div class="panes">
    <figure class="source pane-editor">
      <figcaption class="source-head">
        <span class="path">{sample.path}</span>
        <span data-role="ink-state">{sample.wasm}</span>
      </figcaption>

      <div class="editor">
        <pre
          class="editor-ink"
          data-role="ink"
          aria-hidden="true"
          set:html={seedInk}
        />
        <textarea
          class="editor-text"
          data-role="source"
          data-path={sample.path}
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          wrap="off"
          readonly={editable ? undefined : true}
          aria-label={`iyi source, ${sample.path}`}>{seed}</textarea
        >
      </div>
    </figure>

    <div class="console pane-output" data-role="output">
      <div class="console-chrome">
        <i aria-hidden="true"></i><i aria-hidden="true"></i><i
          aria-hidden="true"></i>
        <span class="caption">output</span>
      </div>
      <pre class="out idle">Press Run.</pre>
    </div>
  </div>

  <p class="foot" data-role="staleness">
    {
      supports("run")
        ? `Run executes ${sample.wasm}, the module the compiler built from this file. Nothing on this page compiles what you type.`
        : "The active engine cannot run, so nothing here executes."
    }{" "}
    <a href={`${base}playground/evidence/`}>How this works</a>
  </p>

  <nav class="tour" aria-label="Samples">
    {prev ? <a href={playgroundHref(prev.id)}>&larr; {prev.id}</a> : <span />}
    {next ? <a href={playgroundHref(next.id)}>{next.id} &rarr;</a> : <span />}
  </nav>
</section>

<script>
  /**
   * The live half. It imports the same registry the build did, so what runs in
   * the browser is what the page said it was. Until an engine claims at least
   * one capability this script does nothing at all, which is the honest resting
   * state and not an error.
   */
  import { activeEngine } from "../playground/registry";
  import type { Capability, RunEvent } from "../playground/types";
  import { CAPABILITY_LABEL } from "../playground/types";
  import { diagnosticHtml } from "../playground/render";

  (() => {
    const engine = activeEngine();
    const caps = engine.capabilities();
    const supports = (cap: Capability) => caps.supported.includes(cap);

    const pick = <T extends HTMLElement>(role: string) =>
      document.querySelector<T>(`[data-role="${role}"]`);

    const source = pick<HTMLTextAreaElement>("source");
    const ink = pick<HTMLPreElement>("ink");
    const output = pick<HTMLDivElement>("output");
    const inkState = pick<HTMLElement>("ink-state");
    const staleness = pick<HTMLElement>("staleness");
    const resetBtn = pick<HTMLButtonElement>("reset");
    const cancelBtn = pick<HTMLButtonElement>("cancel");

    if (!source || !ink || !output || !inkState || !staleness) return;
    if (!resetBtn || !cancelBtn) return;
    if (caps.supported.length === 0) return;

    /* The recorded program and its recorded colouring, taken from the page the
     * build produced rather than shipped a second time in this bundle. */
    const recorded = ink.textContent ?? "";
    const recordedInk = ink.innerHTML;
    const entry = source.dataset.path ?? "main.iyi";
    const wasm = `${entry.replace(/^.*\//, "").replace(/\.iyi$/, "")}.wasm`;
    const detail = staleness.querySelector("a");

    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("button[data-control]"),
    );

    const encoder = new TextEncoder();
    const withinBudget = () =>
      caps.maxSourceBytes > 0 &&
      encoder.encode(source.value).length <= caps.maxSourceBytes;
    /* A textarea normalises its own line endings, so comparing raw would report
     * an edit the visitor did not make. */
    const edited = () =>
      source.value.replace(/\r\n/g, "\n") !== recorded.replace(/\r\n/g, "\n");

    let running = false;

    const refreshDisabled = () => {
      for (const btn of buttons) {
        const cap = btn.dataset.control as Capability;
        btn.disabled = !supports(cap) || !withinBudget() || running;
      }
      cancelBtn.hidden = !running;
    };

    /* The honest treatment of a stale edit. The colouring is withdrawn,
     * because the tokens came from the compiler's lexer and there is no lexer
     * in this page; the run control renames itself; and the line under the
     * panes says which bytes will execute. */
    const refreshStaleness = () => {
      const stale = edited();

      ink.hidden = stale;
      source.classList.toggle("plain", stale);
      resetBtn.hidden = !stale;
      inkState.textContent = stale ? "edited" : wasm;

      if (supports("run")) {
        staleness.firstChild!.textContent = stale
          ? `Run executes the recorded ${wasm}, not what you typed: nothing on this page compiles iyi. `
          : `Run executes ${wasm}, the module the compiler built from this file. Nothing on this page compiles what you type. `;
        if (detail) staleness.appendChild(detail);
      }

      for (const btn of buttons) {
        const stalest = btn.dataset.labelStale;
        const plain = btn.dataset.label;
        if (stalest === undefined || plain === undefined) continue;
        /* The name goes on the label element, not on the button, so the chord
         * beside it survives. */
        const label = btn.querySelector<HTMLElement>(".run-label") ?? btn;
        label.textContent = stale ? stalest : plain;
      }
    };

    /* Runtime nodes cannot carry Astro's scoped attributes, so they use the
     * global classes code.css already defines plus the ones declared global
     * below. */
    const appendBlock = (cls: string, text: string) => {
      const pre = document.createElement("pre");
      pre.className = cls;
      pre.textContent = text;
      output.appendChild(pre);
      return pre;
    };

    /* The block a run of output is flowing into, and which stream it belongs
     * to. A terminal draws no boundary between two writes, so a contiguous run
     * of writes to the same descriptor flows into one block and only a change
     * of descriptor, or anything else happening, starts a new one. */
    let flowing: { fd: "out" | "err"; pre: HTMLPreElement } | null = null;

    const appendStream = (fd: "out" | "err", text: string) => {
      if (flowing === null || flowing.fd !== fd) {
        const pre = appendBlock("out", "");
        if (fd === "err") {
          const lead = document.createElement("span");
          lead.className = "prompt";
          lead.textContent = "[stderr] ";
          pre.appendChild(lead);
        }
        flowing = { fd, pre };
      }
      flowing.pre.appendChild(document.createTextNode(text));
    };

    /* What ran, said once at the end: the module, its size, the exit status
     * and the wall clock, on one line. */
    let artifact = "";

    const onEvent = (event: RunEvent) => {
      if (event.kind !== "stdout" && event.kind !== "stderr") flowing = null;

      switch (event.kind) {
        case "stdout":
          appendStream("out", event.text);
          break;
        case "stderr":
          appendStream("err", event.text);
          break;
        case "diagnostic": {
          const block = document.createElement("div");
          block.className = "diagnostic";
          block.innerHTML = diagnosticHtml(event);
          output.appendChild(block);
          break;
        }
        case "artifact":
          artifact = `${event.name}, ${event.bytes} bytes`;
          break;
        case "exit":
          appendBlock(
            "stamp",
            `${artifact ? `${artifact}, ` : ""}exit ${event.code}, ${event.ms} ms`,
          );
          break;
        case "unsupported":
          /* The engine says before every run that it did not compile. That is
           * the line under the panes; in the console it is one quiet sentence
           * rather than a refusal, because the run that follows is real. Any
           * other refusal is a real one. */
          if (event.capability === "compile") {
            appendBlock("note", "Running the recorded module.");
          } else {
            appendBlock(
              "gap",
              `cannot ${CAPABILITY_LABEL[event.capability]} here: ${event.reason}`,
            );
          }
          break;
      }
    };

    const doRun = async (want: Capability) => {
      if (running) return;
      if (!withinBudget()) {
        output.querySelectorAll("pre, .diagnostic").forEach((n) => n.remove());
        appendBlock(
          "gap",
          `this engine accepts ${caps.maxSourceBytes} bytes of source and the pane holds ${encoder.encode(source.value).length}, so nothing ran`,
        );
        return;
      }
      running = true;
      refreshDisabled();
      output.querySelectorAll("pre, .diagnostic").forEach((n) => n.remove());
      flowing = null;
      artifact = "";
      const waiting = appendBlock("out idle", "Running.");
      try {
        await engine.ready();
        let first = true;
        for await (const event of engine.run(
          [{ path: entry, text: source.value }],
          { entry, want },
        )) {
          if (first) {
            waiting.remove();
            first = false;
          }
          onEvent(event);
        }
        if (first) {
          waiting.remove();
          appendBlock(
            "gap",
            `the engine finished ${want} without reporting anything at all, which the contract does not allow`,
          );
        }
      } catch (error) {
        waiting.remove();
        appendBlock(
          "gap",
          `the engine itself failed, which is not the program's fault: ${
            error instanceof Error ? error.message : String(error)
          }`,
        );
      } finally {
        running = false;
        refreshDisabled();
      }
    };

    for (const btn of buttons) {
      btn.addEventListener("click", () =>
        doRun(btn.dataset.control as Capability),
      );
    }

    cancelBtn.addEventListener("click", () => engine.cancel());

    resetBtn.addEventListener("click", () => {
      source.value = recorded;
      ink.innerHTML = recordedInk;
      refreshStaleness();
      refreshDisabled();
      source.focus();
      source.setSelectionRange(0, 0);
      source.scrollTop = 0;
      source.scrollLeft = 0;
      ink.scrollTop = 0;
      ink.scrollLeft = 0;
    });

    /* The colouring sits behind the text, so the two have to scroll together or
     * the emphasis slides off the tokens it belongs to. */
    source.addEventListener("scroll", () => {
      ink.scrollTop = source.scrollTop;
      ink.scrollLeft = source.scrollLeft;
    });

    source.addEventListener("input", () => {
      refreshStaleness();
      refreshDisabled();
    });

    /* Cmd or Ctrl and Enter runs, from anywhere on the page. */
    const chord = (event: KeyboardEvent) => {
      if (event.key !== "Enter") return;
      if (!event.metaKey && !event.ctrlKey) return;
      event.preventDefault();
      void doRun("run");
    };
    document.addEventListener("keydown", chord);

    refreshStaleness();
    refreshDisabled();
  })();
</script>

<style>
  .bench {
    margin-block: 2rem 3rem;
  }

  .bench-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-end: 1.25rem;
  }

  .bench-title h1 {
    font-family: var(--font-mono);
    font-size: var(--step-2);
    margin: 0.2rem 0 0.3rem;
  }

  .bench-title .label a {
    color: inherit;
  }

  .pitch {
    margin: 0;
    max-width: var(--measure);
    color: var(--graphite);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .bar .cta {
    padding: 0.55rem 1rem;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .bar .cta[hidden] {
    display: none;
  }

  .bar .run:disabled {
    cursor: not-allowed;
    background: var(--track);
    color: var(--mute);
  }

  .chord {
    font-weight: 400;
    font-size: var(--step--2);
    opacity: 0.8;
  }

  /* The sample menu. A disclosure holding real links, so it needs no script and
   * a deep link into it is a URL rather than a state. */
  .menu {
    position: relative;
  }

  .menu summary {
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary::after {
    content: "";
    display: inline-block;
    border: 0.3em solid transparent;
    border-top-color: currentColor;
    transform: translateY(0.2em);
  }

  .menu-body {
    position: absolute;
    z-index: 2;
    inset-inline-end: 0;
    inset-block-start: calc(100% + 0.4rem);
    min-width: 14rem;
    max-height: 22rem;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    background: var(--paper);
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .pick {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .pick:hover {
    color: var(--ink);
    background: var(--raise);
    text-decoration: none;
  }

  .pick[aria-current="page"] {
    color: var(--brand-deep);
    font-weight: 600;
  }

  /* THE PANES. Editor first in source order, so the stacked order below the
   * breakpoint is program then output with no reordering. */
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (max-width: 62rem) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .pane-editor {
    margin: 0;
    border-radius: var(--radius);
    background: var(--paper);
  }

  /* Two layers in one grid cell: the recorded colouring behind, the editable
   * text in front with its glyphs made transparent so the layer underneath shows
   * through. Every metric that affects where a glyph lands is declared on both,
   * because one difference in padding or line height slides the emphasis off the
   * tokens it belongs to.
   *
   * Selectors are two classes deep so they beat `.source pre` from code.css,
   * which sets `overflow: visible` and would otherwise stop the two layers
   * scrolling as one. */
  .editor {
    display: grid;
    height: clamp(22rem, 62vh, 44rem);
  }

  .editor .editor-ink,
  .editor .editor-text {
    grid-area: 1 / 1;
    margin: 0;
    padding: 0.95rem 1.1rem;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-ligatures: none;
    line-height: 1.58;
    letter-spacing: normal;
    word-spacing: normal;
    tab-size: 2;
    white-space: pre;
  }

  .editor .editor-ink {
    color: var(--ink);
    overflow: hidden;
    pointer-events: none;
  }

  .editor .editor-text {
    color: transparent;
    -webkit-text-fill-color: transparent;
    caret-color: var(--ink);
    overflow: auto;
    resize: none;
  }

  .editor .editor-text.plain {
    color: var(--ink);
    -webkit-text-fill-color: var(--ink);
  }

  .editor .editor-text::selection {
    background: var(--track);
  }

  .editor .editor-text:focus {
    outline: none;
  }

  .pane-editor:focus-within {
    border-color: var(--graphite);
  }

  .pane-output {
    min-height: 12rem;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
  }

  .pane-output pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pane-output :global(.idle) {
    color: var(--mute);
  }

  .foot {
    margin: 0.9rem 0 0;
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .tour {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 2rem;
    padding-block-start: 1rem;
    border-top: var(--hair) solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  /* Runtime-only blocks: nodes the client script creates cannot carry Astro's
   * scoped attributes, so these are declared global. */
  :global(.gap) {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  :global(.note),
  :global(.stamp) {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--mute);
    line-height: 1.6;
  }

  :global(.note) {
    padding-block-end: 0 !important;
  }

  :global(.stamp) {
    margin-block-start: auto !important;
    border-top: var(--hair) solid var(--hairline);
  }
</style>
