---
import Page from "../layouts/Page.astro";

const base = import.meta.env.BASE_URL;
---

<Page title="Not found" summary="There is no page at this address.">
  <section class="wrap lost">
    <img src={`${base}mascot.webp`} alt="" width="160" height="150" />
    <div>
      <p class="label">404</p>
      <h1>Nothing here.</h1>
      <p>
        The address does not name a page on this site. The tour, the lessons
        and the spec are where most things live.
      </p>
      <div class="hero-cta">
        <a class="cta" href={base}>Home</a>
        <a class="cta ghost" href={`${base}playground/`}>Take the tour</a>
      </div>
    </div>
  </section>

  <style>
    .lost {
      display: flex;
      gap: 2.5rem;
      align-items: center;
      padding-block: clamp(3rem, 8vw, 6rem);
      flex-wrap: wrap;
    }

    .lost img {
      width: 10rem;
      height: auto;
    }

    .lost h1 {
      font-size: var(--step-4);
      margin-block: 0.3rem 0.8rem;
    }

    .lost p {
      color: var(--graphite);
      max-width: 44ch;
    }

    .hero-cta {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-block-start: 1.2rem;
    }
  </style>
</Page>
