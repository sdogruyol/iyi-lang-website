---
/**
 * A table quoted out of README.md, by the id `scripts/samples.mjs` gave it.
 * Cells are the README's markdown, rendered inline, and the caption names the
 * lines they came from. Nothing here is retyped: the comparison a reader sees
 * is the one the README states, and a README that drops the table fails the
 * build here rather than leaving a stale copy on the page.
 */
import tables from "../generated/tables.json";
import { inlineMarkdown } from "../lib/lessons";

interface Props {
  id: keyof typeof tables;
  caption?: string;
}

const { id, caption } = Astro.props;
const table = tables[id];

if (!table) {
  throw new Error(
    `Compare: "${id}" is not a table scripts/samples.mjs extracts. It has ` +
      `${Object.keys(tables).join(", ")}.`,
  );
}
---

<figure class="compare">
  <div class="scroll">
    <table>
      <thead>
        <tr>
          {table.header.map((cell) => <th set:html={inlineMarkdown(cell)} />)}
        </tr>
      </thead>
      <tbody>
        {
          table.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td class:list={[{ why: i === row.length - 1 }]} set:html={inlineMarkdown(cell)} />
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption>{caption ? `${caption}. ` : ""}Quoted verbatim from {table.cite}.</figcaption>
</figure>

<style>
  .compare {
    margin: 0;
  }

  .scroll {
    overflow-x: auto;
    border: var(--hair) solid var(--hairline);
    border-radius: var(--radius);
    background: var(--paper);
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 40rem;
    font-size: var(--step--1);
  }

  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.7rem 0.9rem;
    border-bottom: var(--hair) solid var(--hairline);
  }

  th {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
    background: var(--raise);
    font-weight: 500;
  }

  th:nth-child(2) {
    color: var(--brand-deep);
  }

  tr:last-child td {
    border-bottom: 0;
  }

  td:nth-child(2) {
    color: var(--ink);
    font-weight: 500;
  }

  td.why {
    color: var(--graphite);
  }

  td :global(code) {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  figcaption {
    margin-block-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--mute);
  }
</style>
