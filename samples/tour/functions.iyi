# Functions: `def`, typed parameters, a typed result.

def add(a : Int32, b : Int32) : Int32
  a + b
end

# The last expression is the result. There is no `return` needed.
def describe(n : Int32) : String
  if n < 0
    "negative"
  elsif n == 0
    "zero"
  else
    "positive"
  end
end

# Parameters can have defaults, and callers can name them.
def greet(name : String, greeting = "Hello") : String
  "#{greeting}, #{name}!"
end

puts add(2, 3)
puts describe(-5)
puts greet("Ayşe")
puts greet("Ayşe", greeting: "Selam")
