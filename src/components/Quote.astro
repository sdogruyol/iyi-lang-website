---
/**
 * A verbatim recording quoted out of README.md.
 *
 * `scripts/samples.mjs` finds the block by an anchor string that has to match
 * exactly one fenced block in the whole README, and carries the line numbers it
 * came from. Nothing here retypes output. A page that invented a terminal
 * session would be the same failure as a page that invented a number.
 *
 * Three faces. Two are already styled in styles/code.css and classified by
 * src/lib/recording.ts, which BreakRule shares so that a caret line means the
 * same thing wherever a recording is set:
 *
 *   console     a recording of a real run. Prompts and commands are marked,
 *               output is not, because nothing highlighted it in the terminal.
 *   diagnostic  a compiler error. iyi's errors name the rule they enforce,
 *               which is a feature, so this is a designed component rather
 *               than a red box, and the caret line is preserved exactly.
 *   source      a listing README.md shows and this site has no recording of,
 *               set in plain ink, because colouring comes from the compiler's
 *               lexer or not at all. `caption` is the path the listing is of.
 */
import readme from "../generated/readme.json";
import { renderRecording } from "../lib/recording";

interface Props {
  id: string;
  as?: "console" | "diagnostic" | "source";
  caption?: string;
}

const { id, as = "console", caption } = Astro.props;

type Block = { text: string; from: number; to: number; source: string; cite: string };

const block = (readme as Record<string, Block>)[id];

if (!block) {
  throw new Error(
    `Quote: "${id}" is not a recording scripts/samples.mjs extracts. It has ` +
      `${Object.keys(readme).join(", ")}. Add an anchor to WANTED in that ` +
      `script rather than typing the output into a page.`,
  );
}

const body = as === "source" ? null : renderRecording(block.text, as);
---

{
  as === "console" ? (
    <div class="console">
      <div class="console-chrome">
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <i aria-hidden="true" />
        <span class="caption">{caption ?? `quoted from ${block.cite}`}</span>
      </div>
      <pre set:html={body} />
    </div>
  ) : as === "diagnostic" ? (
    <div class="diagnostic">
      <pre set:html={body} />
      <span class="cites">
        {caption ? `${caption}. ` : ""}Quoted verbatim from {block.cite}.
      </span>
    </div>
  ) : (
    <figure class="source">
      <figcaption class="source-head">
        <span class="path">{caption}</span>
        <span>quoted from {block.cite}</span>
      </figcaption>
      <pre><code>{block.text}</code></pre>
    </figure>
  )
}
