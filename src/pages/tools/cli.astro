---
/**
 * The command line, as the binary describes itself.
 *
 * Everything on this page is `records/cli.json`: the usage text lifted from
 * src/compiler/iyi.cr and proved equal to what `iyi help` prints, and one
 * recorded `iyi <verb> --help` per verb the compiler dispatches. No switch is
 * typed here. A CLI reference is the page that rots first, and the only way to
 * keep one honest is to stop writing it.
 */
import Page from "../../layouts/Page.astro";
import Lifted from "./_Lifted.astro";
import cli from "../../../records/cli.json";

const base = import.meta.env.BASE_URL;

const verbs = cli.verbs;
const lines = verbs.reduce((total, verb) => total + verb.lines, 0);
---

<Page
  kind="TechArticle"
  title="The command line"
  summary="Every iyi subcommand and what it prints for --help, recorded from the compiler itself: build, run, mod, doc, repl, test, vet, check, fix, bind, migrate, lsp, mcp, daemon, env, clear_cache and tool."
>
  <section class="wrap head">
    <p class="label">Tools, the command line</p>
    <h1>{verbs.length} verbs, one binary.</h1>
    <p class="lede">
      Every block here is a recording: what the compiler printed when it was
      asked, {lines} lines of help in all. The list is what the binary
      dispatches, not a list somebody kept up to date.
    </p>
  </section>

  {/* One row per verb, its help folded. A reference is read by looking one
      thing up, and the first draft of this page printed every line of help at
      once, which is a wall to scroll past rather than a reference to use.
      `<details>` needs no script for the fold itself, so a reader with scripts
      blocked gets rows that are all one click from open. The script below
      handles the two cases a closed disclosure cannot. */}
  <section class="wrap">
    <ul class="verbs">
      {verbs.map((verb) => (
        <li id={verb.name}>
          <details>
            <summary>
              <code>iyi {verb.name}</code>
              <span>{verb.summary}</span>
            </summary>
            <Lifted
              text={verb.help}
              caption={verb.command}
              cite={`${verb.lines} lines, recorded with ${cli.recorded.compiler}`}
            />
          </details>
        </li>
      ))}
    </ul>
    <p class="sub">
      <code>help</code> and <code>version</code> are answered by the front door
      itself. {cli.crystal_only.map((entry) => entry.name).join(", ")} belong to
      Crystal, which this compiler is also built on, and typing one gets a
      sentence saying where it went rather than an unknown command.
    </p>
  </section>

  <section class="wrap next">
    <div class="hero-cta">
      <a class="cta" href={`${base}install/`}>Get the binary</a>
      <a class="cta ghost" href={`${base}tools/mcp/`}>The same verbs over MCP</a>
      <a class="cta ghost" href={`${base}tools/editor/`}>Editors</a>
    </div>
    <dl class="evidence">
      <dt>recorded by</dt>
      <dd>{cli.recorded.compiler}, at {cli.recorded.commit}</dd>
      <dt>with</dt>
      <dd><code>{cli.recorded.command}</code></dd>
      <dt>usage read from</dt>
      <dd>{cli.usage.cite}, dispatch at {cli.usage.dispatch}</dd>
    </dl>
  </section>

  {/* Two things a closed `<details>` cannot do for itself.

      A fragment has to land on an open verb: `/tools/cli/#check` is the shape
      of link this page exists to be, and arriving at a collapsed row is a
      reference hiding the thing it was asked for. And paper has no affordance
      for a disclosure, so a printed page has to carry all of them.

      Neither is doable in CSS today: a closed `<details>` hides its content by
      a mechanism `display` cannot reach, and `::details-content` is too new to
      rely on. So both are a script, and the fallback is honest either way: no
      script means a reference whose rows are all one click from open. */}
  <script>
    const rows = document.querySelectorAll<HTMLDetailsElement>(".verbs details");

    const openTarget = () => {
      const id = location.hash.slice(1);
      if (!id) return;
      const row = document.getElementById(id)?.querySelector<HTMLDetailsElement>("details");
      if (row) row.open = true;
    };

    openTarget();
    addEventListener("hashchange", openTarget);
    addEventListener("beforeprint", () => {
      for (const row of rows) row.open = true;
    });
  </script>

  <style>
    section {
      padding-block: clamp(1rem, 2vw, 1.6rem);
    }

    .head {
      padding-block-start: clamp(2.5rem, 5vw, 4rem);
    }

    .head h1 {
      font-size: var(--step-4);
      margin-block: 0.5rem 0.8rem;
    }

    .lede {
      color: var(--graphite);
      max-width: 62ch;
      margin-block-end: 1.4rem;
    }

    /* A verb is a landing target from a fragment, so it gets air under the
     * masthead when a reader jumps to it, and it opens on arrival. */
    .verbs {
      list-style: none;
      margin: 0 0 1.4rem;
      padding: 0;
      border-block-start: var(--hair) solid var(--hairline);
    }

    .verbs > li {
      border-block-end: var(--hair) solid var(--hairline);
      scroll-margin-block-start: 4.5rem;
    }

    .verbs summary {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
      flex-wrap: wrap;
      padding-block: 0.6rem;
      cursor: pointer;
      color: var(--graphite);
      font-size: var(--step--1);
    }

    .verbs summary code {
      min-width: 9.5rem;
      color: var(--ink);
      background: none;
      border: 0;
      padding: 0;
      font-weight: 500;
    }

    .verbs summary:hover code {
      color: var(--brand-deep);
    }

    .verbs details[open] summary {
      margin-block-end: 0.4rem;
    }

    .verbs details > :not(summary) {
      margin-block-end: 0.9rem;
    }

    .sub {
      color: var(--graphite);
      max-width: 62ch;
      margin-block-end: 0.8rem;
    }

    .next {
      padding-block: 2rem 3rem;
    }

    .hero-cta {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-block-end: 1.5rem;
    }
  </style>
</Page>
