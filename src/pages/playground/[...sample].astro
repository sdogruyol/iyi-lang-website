---
/**
 * One route per recorded sample, and each one really runs.
 *
 * WHAT THESE PAGES ARE. `/playground/` itself is parked: the playground worth
 * having is an editor with iyi's own compiler running in the tab, and that
 * waits on language work. These routes are the part that honestly works today.
 * Each one carries one program, its recorded colouring from the compiler's own
 * lexer, and a run that fetches the module the compiler built from that file,
 * checks its digest against the record, and executes it in this page.
 *
 * So the lessons' deep links keep resolving to something that does something,
 * which is the whole reason the routes survived the parking of the page above
 * them. `index.astro` owns `/playground/` and a static route wins over a rest
 * parameter, so the bare path is not generated here.
 *
 * WHY A ROUTE PER SAMPLE RATHER THAN A PICKER THAT SWAPS IN THE BROWSER. Each
 * page carries exactly one program and one recorded colouring. The alternative
 * was one page holding every sample, which would have meant shipping every
 * listing to every visitor so a control could reveal one of them. A site
 * arguing that a program should link only what it uses does not get to do that,
 * and there is a second reason that matters more: a real URL resolves before
 * any script runs, so a lesson's link works with scripts off and survives being
 * bookmarked or shared.
 *
 * WHAT THIS ROUTE HANDS THE BROWSER. One entry out of
 * `src/generated/playground/`, written by `scripts/records.mjs` as this
 * sample's slice of the verified manifest: the module's name and digest, the
 * digest of the source the module was built from, and the recording's
 * provenance. The glob below is read in node at
 * build time, and only the one entry this page is about reaches the page. The
 * island used to reach the whole manifest and the whole diagnostics record
 * through the engine's import graph, which is what that costs and why it
 * stopped.
 */
import Page from "../../layouts/Page.astro";
import Playground from "../../components/Playground.astro";
import type { TourStep } from "../../playground/samples";
import type { SampleEntry } from "../../playground/entry";
import { curatedSamples, tourSamples } from "../../playground/samples";

/* Eager because this runs in node during the static build and every route
 * needs one of these. Astro never sends a frontmatter import to a browser, so
 * what is shipped is what the component serialises and nothing else. */
const written = import.meta.glob<SampleEntry>("../../generated/playground/*.json", {
  eager: true,
  import: "default",
});

const entries: Record<string, SampleEntry> = {};
for (const entry of Object.values(written)) entries[entry.id] = entry;

export function getStaticPaths() {
  /* Every step of the tour, runnable or recorded, and every runnable sample
   * of the repository's. The record decides what exists, so a repository
   * sample that failed to record has no page rather than a page that cannot
   * run. */
  const rest = curatedSamples.filter((sample) => sample.set === "iyi");
  return [...tourSamples, ...rest].map((sample) => ({
    params: { sample: sample.id },
    props: { sample },
  }));
}

interface Props {
  sample: TourStep;
}

const { sample } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/*$/, "/");
const runs = "wasm" in sample;

/* The slice for this sample. Missing is fatal rather than silently absent: a
 * page rendered without it would carry an editor that cannot tell whether the
 * text in it is still the recorded program, and a run control with no digest
 * to check the module against. */
const entry = entries[sample.id];
if (entry === undefined) {
  throw new Error(
    `playground: no entry for "${sample.id}" in src/generated/playground/. ` +
      `scripts/records.mjs writes one per sample in the verified manifest, ` +
      `so a missing one means the generator did not run or the manifest does ` +
      `not name this sample.`,
  );
}
---

<Page
  title={`${sample.id}, from the tour`}
  summary={
    runs
      ? `${sample.path}, cross-compiled to wasm32-wasi by the iyi compiler and executed on this page.`
      : `${sample.path}, and what it printed when the iyi compiler ran it natively.`
  }
>
  <Playground sample={sample} entry={entry} />

  <section class="wrap honest">
    <p>
      {
        runs
          ? "This page runs the module the compiler built from the listing above. You can type in the pane: nothing here compiles, so what you type cannot run, and the page says which bytes it is running the moment the text stops being the recorded file. There is no standard input, no filesystem and no threads on this target, and one sample fails on purpose for exactly that reason."
          : "This program does not compile for the browser's target, so this page shows what it printed when the compiler ran it natively, on the machine named above. You can still type in the pane, and the page will say when what is in it is no longer the file the recording is about."
      }{" "}
      <a href={`${base}playground/evidence/`}>The recordings behind this</a>{" "}
      say which bytes ran and what checked them.
    </p>
  </section>
</Page>

<style>
  .honest p {
    max-width: var(--measure);
    color: var(--graphite);
    font-size: var(--step--1);
    margin: 0;
  }
</style>
