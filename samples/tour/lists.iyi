# Arrays and hashes.

cities = ["Istanbul", "Ankara", "Izmir"]
puts cities.size
puts cities.first
cities << "Bursa"
puts cities.join(", ")

# Blocks work on every element.
cities.each { |city| puts city.upcase }
puts cities.select { |city| city.size > 5 }.join(", ")

# A hash maps keys to values.
population = {} of String => Int32
population["Istanbul"] = 15
population["Ankara"] = 5
population.each { |city, millions| puts "#{city}: #{millions} million" }
