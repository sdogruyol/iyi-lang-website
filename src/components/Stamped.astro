---
/**
 * A RECORDED measurement: seconds, bytes, milliseconds.
 *
 * These are a machine, not a language, so the headline is the RATIO, because
 * a ratio survives the machine. The absolute is demoted to the body, where it
 * sits next to its spread. The frame is a calibration card and its left edge
 * carries instrument ticks, which is the visual signature that separates a
 * recorded number from a structural one at a glance.
 *
 * THE CARD USED TO CARRY ITS OWN PROVENANCE and no longer does. It printed
 * MACHINE and PRINTS IT as a labelled rail under every claim, and with six
 * recorded facts on the site that was four rows of near-identical furniture
 * per card. It is gone from the page.
 *
 * Where it went, and this is the part that matters: the record still has it
 * and is still gated. `scripts/facts.mjs` refuses to write `facts.json` when
 * a recorded group names no command or no machine, so every figure this
 * component renders is still one whose box and command are written down and
 * checkable in the repository. The colophon on every page names the generator
 * and the commit. What changed is that the page no longer repeats the box
 * beside each number; what did not change is that a number with no box cannot
 * reach the page at all, because it cannot reach the record.
 */
interface Props {
  /** The claim, machine-independent, stated large. */
  claim: string;
  /** What the claim is a claim about. */
  subject: string;
  /** Optional band, where a claim held across several readings. */
  band?: string;
  /** Marks a measurement iyi loses. Drives the signal colour. */
  outcome?: "win" | "loss" | "flat";
}

const { claim, subject, band, outcome = "flat" } = Astro.props;
---

<figure class="stamped" data-outcome={outcome}>
  <div class="ticks" aria-hidden="true"></div>

  <div class="card">
    <figcaption class="head">
      <span class="label">measured</span>
      <span class="subject">{subject}</span>
    </figcaption>

    <p class="claim">{claim}</p>
    {band && <p class="band">{band}</p>}

    <div class="body"><slot /></div>
  </div>
</figure>

<style>
  .stamped {
    margin: 1.8rem 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
  }

  /* Instrument ticks. A recorded number came off a machine, and this is the
   * mark that says so. A structural number has no ticks, which is how the two
   * classes stay visually distinct without a colour or a badge. */
  .ticks {
    width: 13px;
    border-block: var(--hair) solid var(--hairline);
    border-inline-start: var(--hair) solid var(--hairline);
    /* A ruler edge. Every sixth pixel carries a tick, and every fifth tick is
     * long, the way a scale is marked, so the eye reads "instrument" before it
     * reads any text. A structural number has no edge at all, and that absence
     * is the whole distinction between the two classes. */
    background-image:
      repeating-linear-gradient(
        to bottom,
        var(--mute) 0 1px,
        transparent 1px 6px
      ),
      repeating-linear-gradient(
        to bottom,
        var(--graphite) 0 1px,
        transparent 1px 30px
      );
    background-size:
      5px 100%,
      10px 100%;
    background-position:
      left top,
      left top;
    background-repeat: no-repeat, no-repeat;
  }

  .card {
    border: var(--hair) solid var(--hairline);
    border-inline-start: 0;
    /* The bottom used to be zero because the provenance rail carried its own
     * padding. With the rail gone the card closes itself. */
    padding: 0.95rem 1.15rem 1.1rem;
    background: var(--raise);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-block-end: 0.55rem;
  }

  .subject {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--graphite);
  }

  /* The ratio. Set in the author's voice at display size, because it is the
   * claim being made, and it does not move when the machine does. */
  .claim {
    font-family: var(--font-text);
    font-variation-settings: "opsz" 48;
    font-size: var(--step-3);
    font-weight: 620;
    line-height: var(--lead-tight);
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
  }

  .stamped[data-outcome="loss"] .claim {
    color: var(--signal);
  }

  .band {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--graphite);
    margin: 0.3rem 0 0;
  }

  .body {
    margin-block-start: 1rem;
  }
</style>
