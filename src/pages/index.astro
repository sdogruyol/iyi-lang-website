---
import Page from "../layouts/Page.astro";
import Measure from "../components/Measure.astro";
import Stamped from "../components/Stamped.astro";
import DurationChart from "../components/DurationChart.astro";
import Sample from "../components/Sample.astro";
import Quote from "../components/Quote.astro";
import facts from "../generated/facts.json";
import { findSample } from "../playground/samples";

/* The tour's first program and what it printed, out of the wasm record. The
 * build refuses a home page whose hello the recorder did not run. */
const hello = findSample("samples/tour/hello.iyi");
if (hello === null) {
  throw new Error("samples/tour/hello.iyi is not in records/wasm/manifest.json");
}

const base = import.meta.env.BASE_URL;
const loop = facts.recorded.edit_loop;
const bin = facts.recorded.hello_binary;

const ratios = loop.ratios as number[];
const loopClaim = `About ${loop.claim.value}x less than Crystal, on the line you just changed.`;
const loopBand = `${Math.min(...ratios).toFixed(2)}x to ${Math.max(...ratios).toFixed(2)}x across ${loop.sessions.length} published sessions.`;
const massRatio = Math.round(bin.crystal.kb / bin.iyi.kb);

const starts = [
  {
    title: "Take the tour",
    body: "The language in short programs, from hello to traits, generics and tasks. Each one runs in your browser; nothing needs installing.",
    href: "playground/",
    cta: "Start the tour",
  },
  {
    title: "Learn the rule",
    body: "Five lessons on what makes iyi its own language, each one a real program from the repository, and each one ending in a mistake so you meet the compiler's own error on purpose.",
    href: "learn/",
    cta: "Start the lessons",
  },
  {
    title: "Read the spec",
    body: "The design record, generated verbatim from SPEC.md: what was measured, what was thrown away, and why.",
    href: "spec/",
    cta: "Read the spec",
  },
  {
    title: "Install it",
    body: "One command installs the latest release into ~/.local on Linux or macOS, with both libraries and the samples. The second command runs hello.",
    href: "install/",
    cta: "Install iyi",
  },
];
---

<Page
  title="iyi, a friendly, fast language for people and their agents"
  summary="iyi is a friendly, fast programming language for people and their agents. Modules compile against declarations, so builds are quick, binaries are small, and a tool can read an interface without a repository."
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>A friendly, fast language for people and their agents.</h1>
        <p class="lede">
          iyi is a compiled language with a simple rule at its heart: a module
          builds against its dependencies' declarations, never their bodies. So
          builds are quick, programs are small, and an agent can read exactly
          the interface it needs.
        </p>
        <div class="hero-cta">
          <a class="cta" href={`${base}playground/`}>Take the tour</a>
          <a class="cta ghost" href={`${base}install/`}>Install</a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src={`${base}mascot.webp`}
          alt="The iyi mascot: a smiling red heart with yellow gloves, waving"
          width="480"
          height="450"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="try">
    <div class="wrap try-inner">
      <div class="try-copy">
        <h2>Try iyi</h2>
        <p>
          Looks like Crystal, reads like Ruby, builds like a systems language.
          This is the first program of the tour, and the output beside it is
          what the compiler's build of it printed.
        </p>
        <p>
          <a href={`${base}playground/hello/`}>Run it in the playground</a>
        </p>
      </div>
      <div class="try-run">
        <Sample path="samples/tour/hello.iyi" />
        <div class="console">
          <div class="console-chrome" aria-hidden="true">
            <i></i><i></i><i></i>
            <span class="caption">iyi run samples/tour/hello.iyi</span>
          </div>
          <pre><span class="out">{hello.nativeStdout}</span></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="crystal" id="crystal">
    <div class="wrap crystal-inner">
      <div class="crystal-copy">
        <p class="label">Coming from Crystal?</p>
        <h2>iyi runs your Crystal code today.</h2>
        <p class="crystal-lede">
          iyi's compiler is Crystal's compiler. It builds your{" "}
          <code>.cr</code> files unchanged, and <code>iyi build --crystal</code> gives an iyi
          program Crystal's standard library, <code>require</code>, and the
          shards you already depend on. Kemal, db, ameba, sqlite3: they build
          and they run. You can switch without touching a dependency.
        </p>
        <ul class="checks">
          <li>
            <strong>Your <code>.cr</code> files compile as they are.</strong>{" "}
            Same compiler, same output; nothing to port first.
          </li>
          <li>
            <strong>Your shards work.</strong> With <code>--crystal</code>,{" "}
            <code>require</code> means what it means in Crystal, and a program
            that requires a shard is buildable today.
          </li>
          <li>
            <strong>The syntax is the one you know.</strong> Blocks, union
            types, nil-safety, macros and local inference are all here. What
            iyi adds is a module rule, and the compiler teaches it as you go.
          </li>
        </ul>
        <div class="hero-cta">
          <a class="cta" href="https://github.com/sdogruyol/iyi#the-library-a-program-has">
            Switch from Crystal
          </a>
          <a class="cta ghost" href={`${base}learn/`}>Learn the one rule</a>
        </div>
      </div>
      <div class="crystal-run">
        <Quote id="kemal_site" as="source" caption="site.iyi" />
        <Quote id="kemal_run" as="console" caption="a Kemal server, from an iyi program" />
      </div>
    </div>
  </section>

  <section class="install">
    <div class="wrap install-inner">
      <div>
        <h2>Install in one line</h2>
        <p class="section-sub">
          The latest release into <code>~/.local</code>, on Linux x86-64 or
          macOS arm64, with both libraries and the samples. Then hello.
        </p>
        <p><a href={`${base}install/`}>What the installer does, and the by-hand version</a></p>
      </div>
      <Quote id="install" as="console" caption="install, then run hello" copy />
    </div>
  </section>

  <section class="features">
    <div class="wrap">
      <h2>What iyi is for</h2>
      <p class="section-sub">
        Four things, and they are one design decision seen from four sides.
      </p>
      <ul class="cards">
        <li class="card">
          <p class="card-figure">{loop.claim.value}x</p>
          <h3>Quick to rebuild</h3>
          <p>
            Change one line in one module and build again. iyi reads the
            declarations of everything else and none of the bodies, so the edit
            loop is about {loop.claim.value}x shorter than the same compiler
            without the rule.
          </p>
          <a href={`${base}why/`}>Why it is fast</a>
        </li>
        <li class="card">
          <p class="card-figure mono">iyi mod context</p>
          <h3>Made for agents</h3>
          <p>
            A module's interface is a file, not a convention. One command
            grounds an edit in every import's exact surface,{" "}
            <code>iyi check</code> answers as data with suggested edits, and{" "}
            <code>iyi mcp</code> serves it all over the protocol agents speak.
          </p>
          <a href={`${base}learn/declarations-not-bodies/`}>Declarations, not bodies</a>
        </li>
        <li class="card">
          <p class="card-figure"><Measure of="targets" /></p>
          <h3>Portable</h3>
          <p>
            An iyi program compiles for <Measure of="targets" /> targets, and is
            run on four of them on every build: two flavours of x86-64, aarch64
            under emulation, and wasm32-wasi, which is what the playground on
            this site uses.
          </p>
          <a href={`${base}playground/evidence/`}>How the playground runs</a>
        </li>
        <li class="card">
          <p class="card-figure">{massRatio}x</p>
          <h3>Small and quick to start</h3>
          <p>
            Native code through LLVM, and a program links only what it uses. A
            hello world is about {massRatio}x smaller than the same program
            with Crystal's library, and starts in a fraction of the time.
          </p>
          <a href={`${base}why/`}>The numbers, with the machine they ran on</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="measured">
    <div class="wrap">
      <h2>Measured, not promised</h2>
      <p class="section-sub">
        One line changed in one of 30 modules, <Measure of="generated" /> lines
        in all, built by iyi and by the same compiler under Crystal's rules, by
        a generator that refuses to start the clock until both print the same
        total. The bars run at real speed.
      </p>
      <Stamped
        claim={loopClaim}
        band={loopBand}
        subject={loop.subject}
        machine={loop.machine}
        command={loop.command}
        outcome="win"
      >
        <DurationChart />
      </Stamped>
      <p class="section-sub">
        The rest of the numbers, binary size and start time among them, are on
        the <a href={`${base}why/`}>why page</a>, each with the machine that
        produced it named beside it.
      </p>
    </div>
  </section>

  <section class="starts">
    <div class="wrap">
      <h2>Get started</h2>
      <ul class="cards starts-cards">
        {
          starts.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <a href={s.href.startsWith("http") ? s.href : `${base}${s.href}`}>{s.cta}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    section {
      padding-block: clamp(2.5rem, 5vw, 4.5rem);
    }

    section h2 {
      font-size: var(--step-3);
      margin-block-end: 0.6rem;
    }

    .section-sub {
      color: var(--graphite);
      max-width: 62ch;
      margin-block-end: 1.6rem;
      font-size: var(--step-0);
    }

    /* Hero ------------------------------------------------------------- */

    .hero {
      padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    }

    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 5vw, 4rem);
      align-items: center;
    }

    @media (max-width: 52rem) {
      .hero-inner {
        grid-template-columns: 1fr;
      }
      .hero-art {
        order: -1;
      }
      .hero-art img {
        max-width: 14rem;
      }
    }

    .hero h1 {
      font-size: var(--step-5);
      font-weight: 800;
      letter-spacing: -0.03em;
      max-width: 16ch;
      margin-block-end: 1.1rem;
    }

    .lede {
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--graphite);
      max-width: 48ch;
      margin: 0 0 1.8rem;
    }

    .hero-cta {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .hero-art {
      display: flex;
      justify-content: center;
    }

    .hero-art img {
      width: 100%;
      max-width: 26rem;
      height: auto;
    }

    /* Try -------------------------------------------------------------- */

    .try {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .try-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    @media (max-width: 52rem) {
      .try-inner {
        grid-template-columns: 1fr;
      }
    }

    .try-copy p {
      color: var(--graphite);
      max-width: 40ch;
    }

    .try-run :global(.source) {
      background: var(--paper);
    }

    .try-run .console {
      margin-block-start: 0.9rem;
    }

    /* Crystal ---------------------------------------------------------- */

    .crystal {
      background: var(--brand-soft);
      border-block-end: var(--hair) solid var(--hairline);
    }

    .crystal-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    @media (max-width: 52rem) {
      .crystal-inner {
        grid-template-columns: 1fr;
      }
    }

    .crystal .label {
      color: var(--brand-deep);
    }

    .crystal h2 {
      margin-block: 0.4rem 0.8rem;
    }

    .crystal-lede {
      color: var(--graphite);
      font-size: var(--step-0);
      max-width: 52ch;
    }

    .checks {
      list-style: none;
      margin: 0 0 1.6rem;
      padding: 0;
      display: grid;
      gap: 0.7rem;
      max-width: 52ch;
    }

    .checks li {
      position: relative;
      padding-inline-start: 1.6rem;
      color: var(--graphite);
      font-size: var(--step--1);
    }

    .checks li::before {
      content: "";
      position: absolute;
      left: 0.1rem;
      top: 0.45em;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--brand);
    }

    .checks strong {
      color: var(--ink);
    }

    .crystal-run :global(.source) {
      background: var(--paper);
    }

    .crystal-run :global(.console) {
      margin-block-start: 0.9rem;
    }

    /* Install ---------------------------------------------------------- */

    .install {
      border-block-end: var(--hair) solid var(--hairline);
    }

    .install-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: center;
    }

    @media (max-width: 52rem) {
      .install-inner {
        grid-template-columns: 1fr;
      }
    }

    .install :global(.console pre) {
      white-space: pre;
      overflow-x: auto;
    }

    /* Cards ------------------------------------------------------------ */

    .cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 1.5rem;
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper);
    }

    .card h3 {
      font-size: var(--step-1);
    }

    .card p {
      margin: 0;
      color: var(--graphite);
      font-size: var(--step--1);
      flex: 1;
    }

    .card > a {
      font-weight: 600;
      font-size: var(--step--1);
      margin-block-start: 0.4rem;
    }

    .card .card-figure {
      font-size: var(--step-4);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--brand);
      flex: 0 !important;
    }

    .card .card-figure.mono {
      font-family: var(--font-mono);
      font-size: var(--step-1);
      font-weight: 600;
      letter-spacing: 0;
      padding-block: 0.4em;
    }

    .card-figure :global(.measure-value) {
      color: inherit;
      font-family: inherit;
      font-weight: inherit;
    }

    /* Measured --------------------------------------------------------- */

    .measured {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .measured :global(.stamped) {
      margin-block: 0.5rem 1.4rem;
    }

    .starts-cards .card {
      background: var(--raise);
      border-color: transparent;
    }
  </style>
</Page>
