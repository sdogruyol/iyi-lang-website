---
/**
 * The index over the four documents the repository keeps about itself. Each
 * card's line count is the file's, out of src/generated/project.json, so a
 * card cannot describe a document that has changed underneath it.
 */
import Page from "../../layouts/Page.astro";
import project from "../../generated/project.json";

const base = import.meta.env.BASE_URL;

const documents = project.documents;
const lines = documents.reduce((total, document) => total + document.lines, 0);
---

<Page
  kind="CollectionPage"
  title="The project"
  summary="Contributing, security, conduct and copyright: the four documents the iyi repository keeps about itself, published here verbatim rather than summarised."
>
  <section class="wrap head">
    <p class="label">The project</p>
    <h1>What the repository says about itself.</h1>
    <p class="lede">
      Four documents, {lines} lines, published whole. Not summarised: a summary
      of a security policy is a security policy nobody wrote, and the
      difference between it and the real one is somebody's disclosure going to
      the wrong place. Each page is the file, reassembled from the repository
      at build time and checked byte for byte against it.
    </p>
  </section>

  <section class="wrap">
    <ul class="cards">
      {documents.map((document) => (
        <li>
          <a href={`${base}project/${document.id}/`}>
            <span class="count">{document.file}</span>
            <h2>{document.title}</h2>
            <p>{document.blurb}</p>
            <span class="lines">{document.lines} lines</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="sub">
      Two documents this site does not publish, and links to as text rather
      than as pages: SPEC.md, which is the design and its rules, and
      CHANGELOG.md, which is where a release states what changed. Both live in
      the repository, which is also where their line numbers mean something.
    </p>
  </section>

  <section class="wrap next">
    <h2>Elsewhere</h2>
    <ul class="links">
      <li><a href="https://github.com/iyilang/iyi">The repository</a></li>
      <li><a href={`${base}tools/`}>The tools</a></li>
      <li><a href={`${base}targets/`}>Platforms, and what CI proves</a></li>
      <li><a href={`${base}download/`}>Downloads</a></li>
    </ul>
    <dl class="evidence">
      <dt>generated by</dt>
      <dd>{project.provenance.generator}</dd>
      <dt>read from</dt>
      <dd>{project.provenance.repository}, at {project.provenance.commit}</dd>
    </dl>
  </section>

  <style>
    section {
      padding-block: clamp(1.2rem, 2.5vw, 2rem);
    }

    .head {
      padding-block-start: clamp(2.5rem, 5vw, 4rem);
    }

    .head h1 {
      font-size: var(--step-4);
      margin-block: 0.5rem 0.8rem;
    }

    .lede {
      color: var(--graphite);
      max-width: 62ch;
    }

    .sub {
      color: var(--graphite);
      max-width: 62ch;
      margin-block-start: 1.2rem;
    }

    .cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 1rem;
    }

    .cards a {
      display: block;
      height: 100%;
      padding: 1.1rem 1.2rem;
      border: var(--hair) solid var(--hairline);
      border-radius: 2px;
      color: inherit;
      text-decoration: none;
      background: var(--raise);
    }

    .cards a:hover {
      border-color: var(--graphite);
    }

    .count {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      letter-spacing: 0.08em;
      color: var(--brand);
    }

    .cards h2 {
      font-size: var(--step-1);
      margin-block: 0.3rem 0.4rem;
    }

    .cards p {
      color: var(--graphite);
      margin: 0 0 0.6rem;
      font-size: var(--step--1);
    }

    .lines {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
    }

    .next h2 {
      font-size: var(--step-1);
      margin-block-end: 0.5rem;
    }

    .links {
      list-style: none;
      margin: 0 0 1.4rem;
      padding: 0;
      display: grid;
      gap: 0.4rem;
    }

    .next {
      padding-block-end: 3rem;
    }
  </style>
</Page>
