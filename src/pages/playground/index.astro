---
/**
 * The playground's front door: the tour, as a list.
 *
 * Six short programs, this site's own, each of which runs in the visitor's
 * tab from the module the compiler built for it. The page says that in one
 * line, lists the steps, and gets out of the way. What the playground does
 * not do, compile what a visitor types, is said once under the list rather
 * than argued, because a person who came to press Run asked a one-line
 * question; the full account is on the evidence page and in the spec.
 */
import Page from "../../layouts/Page.astro";
import { tourSamples, playgroundHref } from "../../playground/samples";
import { recordedText } from "../../lib/highlight";
import { lessonHref, sequence } from "../../lib/lessons";

const base = import.meta.env.BASE_URL.replace(/\/*$/, "/");
const lessons = await sequence();
const firstLesson = lessons[0];

/* Each program's first line is a comment saying what it is; the list shows
 * that line, so the description cannot drift from the file. */
const steps = tourSamples.map((sample) => ({
  id: sample.id,
  href: playgroundHref(sample.id),
  blurb: recordedText(sample.path).split("\n")[0].replace(/^#\s*/, ""),
}));
---

<Page
  title="Playground | iyi"
  summary="Six short iyi programs that run in your browser. Read one, press Run, see what it prints."
>
  <section class="wrap head">
    <p class="label">Playground</p>
    <h1>Six short programs. Each one runs in your browser.</h1>
    <p class="one-line">
      Start at the top and work down. Read the program, press Run, see what it
      prints, then move to the next.
    </p>
    <a class="cta" href={steps[0].href}>Start with {steps[0].id}</a>
  </section>

  <section class="wrap">
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li>
            <a class="step" href={step.href}>
              <span class="step-index">{i + 1}</span>
              <span class="step-id">{step.id}</span>
              <span class="step-blurb">{step.blurb}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap after">
    <p>
      Done with the tour? <a href={lessonHref(base, firstLesson)}>Learn the
      one rule</a> that makes iyi its own language, in five lessons that each
      run a real program from the repository.
    </p>
    <p class="honest">
      Each program runs from the module the iyi compiler built for it, checked
      against its recording before it starts. Nothing on these pages compiles
      what you type yet.{" "}
      <a href={`${base}playground/evidence/`}>How this works</a>
    </p>
  </section>

  <style>
    .head {
      padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
    }

    .head h1 {
      font-size: var(--step-4);
      max-width: 22ch;
      margin-block: 0.5rem 0.8rem;
    }

    .one-line {
      color: var(--graphite);
      max-width: 52ch;
      margin-block-end: 1.4rem;
    }

    .steps {
      list-style: none;
      margin: 1.5rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.75rem;
      max-width: 40rem;
    }

    .step {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: baseline;
      gap: 1rem;
      padding: 0.9rem 1.2rem;
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius);
      color: var(--ink);
      text-decoration: none;
    }

    .step:hover {
      border-color: var(--graphite);
      text-decoration: none;
    }

    .step-index {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
      min-width: 1.5ch;
    }

    .step-id {
      font-family: var(--font-mono);
      font-weight: 600;
      color: var(--brand-deep);
    }

    .step-blurb {
      color: var(--graphite);
      font-size: var(--step--1);
    }

    @media (max-width: 40rem) {
      .step {
        grid-template-columns: auto minmax(0, 1fr);
      }
      .step-blurb {
        grid-column: 2;
      }
    }

    .after {
      margin-block-start: 3rem;
      max-width: var(--measure);
    }

    .honest {
      color: var(--graphite);
      font-size: var(--step--1);
    }
  </style>
</Page>
