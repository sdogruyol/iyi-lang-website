# More than one result: a tuple, unpacked at the call.

def divide(a : Int32, b : Int32) : Tuple(Int32, Int32)
  {a // b, a % b}
end

quotient, remainder = divide(17, 5)
puts quotient
puts remainder

# A tuple is a value like any other.
pair = divide(9, 4)
puts pair[0]
puts pair[1]

# `return` leaves early, and can carry a value.
def first_even(numbers : Array(Int32)) : Int32?
  numbers.each do |n|
    return n if n % 2 == 0
  end
  nil
end

puts first_even([1, 3, 6, 7])
puts first_even([1, 3])
