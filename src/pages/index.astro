---
import Page from "../layouts/Page.astro";
import Measure from "../components/Measure.astro";
import Stamped from "../components/Stamped.astro";
import DurationChart from "../components/DurationChart.astro";
import Sample from "../components/Sample.astro";
import facts from "../generated/facts.json";

const base = import.meta.env.BASE_URL;
const loop = facts.recorded.edit_loop;
const bin = facts.recorded.hello_binary;

const ratios = loop.ratios as number[];
const loopClaim = `About ${loop.claim.value}x less than Crystal, on the line you just changed.`;
const loopBand = `${Math.min(...ratios).toFixed(2)}x to ${Math.max(...ratios).toFixed(2)}x across ${loop.sessions.length} published sessions.`;
const massRatio = Math.round(bin.crystal.kb / bin.iyi.kb);

const starts = [
  {
    title: "Learn iyi",
    body: "Five short lessons, each one a real program from the repository that runs, and each one ending in a mistake so you meet the compiler's own error on purpose.",
    href: "learn/",
    cta: "Start the tour",
  },
  {
    title: "Try it in the browser",
    body: "The samples are compiled to wasm and run on the page. Edit them, run them, share a link. Nothing is faked and nothing needs installing.",
    href: "playground/",
    cta: "Open the playground",
  },
  {
    title: "Read the spec",
    body: "The design record, generated verbatim from SPEC.md: what was measured, what was thrown away, and why.",
    href: "spec/",
    cta: "Read the spec",
  },
  {
    title: "Install it",
    body: "Clone the repository, build the compiler, and run a sample. The README walks through it and names every command.",
    href: "https://github.com/sdogruyol/iyi#readme",
    cta: "Get the compiler",
  },
];
---

<Page
  title="iyi, a friendly, fast language for people and their agents"
  summary="iyi is a friendly, fast programming language for people and their agents. Modules compile against declarations, so builds are quick, binaries are small, and a tool can read an interface without a repository."
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>A friendly, fast language for people and their agents.</h1>
        <p class="lede">
          iyi is a compiled language with a simple rule at its heart: a module
          builds against its dependencies' declarations, never their bodies. So
          builds are quick, programs are small, and an agent can read exactly
          the interface it needs.
        </p>
        <div class="hero-cta">
          <a class="cta" href={`${base}learn/`}>Get started</a>
          <a class="cta ghost" href={`${base}playground/`}>Try in the playground</a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src={`${base}mascot.webp`}
          alt="The iyi mascot: a smiling red heart with yellow gloves, waving"
          width="480"
          height="450"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="try">
    <div class="wrap try-inner">
      <div class="try-copy">
        <h2>Try iyi</h2>
        <p>
          Looks like Crystal, reads like Ruby, builds like a systems language.
          This listing comes out of <code>samples/iyi/hello.iyi</code> at build
          time, and the output beside it is a run of the compiler against that
          file.
        </p>
        <p>
          <a href={`${base}playground/`}>Run and edit it in the playground</a>
        </p>
      </div>
      <div class="try-run">
        <Sample path="samples/iyi/hello.iyi" lines="110-118" must="puts announce" />
        <div class="console">
          <div class="console-chrome" aria-hidden="true">
            <i></i><i></i><i></i>
            <span class="caption">iyi run samples/iyi/hello.iyi</span>
          </div>
          <pre><span class="out">Hello, iyi!
HELLO, IYI!
BEEP 42
Hello, crystal!
BEEP 7
-&gt; BEEP 9</span></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="wrap">
      <h2>What iyi is for</h2>
      <p class="section-sub">
        Four things, and they are one design decision seen from four sides.
      </p>
      <ul class="cards">
        <li class="card">
          <p class="card-figure">{loop.claim.value}x</p>
          <h3>Quick to rebuild</h3>
          <p>
            Change one line in one module and build again. iyi reads the
            declarations of everything else and none of the bodies, so the edit
            loop is about {loop.claim.value}x shorter than the same compiler
            without the rule.
          </p>
          <a href={`${base}why/`}>Why it is fast</a>
        </li>
        <li class="card">
          <p class="card-figure mono">iyi mod context</p>
          <h3>Made for agents</h3>
          <p>
            A module's interface is a file, not a convention. One command
            grounds an edit in every import's exact surface, <code>iyi check</code>
            answers as data with suggested edits, and <code>iyi mcp</code>
            serves it all over the protocol agents speak.
          </p>
          <a href={`${base}learn/declarations-not-bodies/`}>Declarations, not bodies</a>
        </li>
        <li class="card">
          <p class="card-figure"><Measure of="targets" /></p>
          <h3>Portable</h3>
          <p>
            An iyi program compiles for <Measure of="targets" /> targets, and is
            run on four of them on every build: two flavours of x86-64, aarch64
            under emulation, and wasm32-wasi, which is what the playground on
            this site uses.
          </p>
          <a href={`${base}playground/evidence/`}>How the playground runs</a>
        </li>
        <li class="card">
          <p class="card-figure">{massRatio}x</p>
          <h3>Small and quick to start</h3>
          <p>
            Native code through LLVM, and a program links only what it uses. A
            hello world is about {massRatio}x smaller than the same program
            with Crystal's library, and starts in a fraction of the time.
          </p>
          <a href={`${base}why/`}>The numbers, with the machine they ran on</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="measured">
    <div class="wrap">
      <h2>Measured, not promised</h2>
      <p class="section-sub">
        One line changed in one of 30 modules, <Measure of="generated" /> lines
        in all, built three ways by a generator that refuses to start the clock
        until all three print the same total. The bars run at real speed.
      </p>
      <Stamped
        claim={loopClaim}
        band={loopBand}
        subject={loop.subject}
        machine={loop.machine}
        command={loop.command}
        outcome="win"
      >
        <DurationChart />
      </Stamped>
      <p class="section-sub">
        Where iyi loses is published too, on the <a href={`${base}why/`}>why page</a>,
        with the same machine named beside it.
      </p>
    </div>
  </section>

  <section class="starts">
    <div class="wrap">
      <h2>Get started</h2>
      <ul class="cards starts-cards">
        {
          starts.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <a href={s.href.startsWith("http") ? s.href : `${base}${s.href}`}>{s.cta}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <style>
    section {
      padding-block: clamp(2.5rem, 5vw, 4.5rem);
    }

    section h2 {
      font-size: var(--step-3);
      margin-block-end: 0.6rem;
    }

    .section-sub {
      color: var(--graphite);
      max-width: 62ch;
      margin-block-end: 1.6rem;
      font-size: var(--step-0);
    }

    /* Hero ------------------------------------------------------------- */

    .hero {
      padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    }

    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 5vw, 4rem);
      align-items: center;
    }

    @media (max-width: 52rem) {
      .hero-inner {
        grid-template-columns: 1fr;
      }
      .hero-art {
        order: -1;
      }
      .hero-art img {
        max-width: 14rem;
      }
    }

    .hero h1 {
      font-size: var(--step-5);
      font-weight: 800;
      letter-spacing: -0.03em;
      max-width: 16ch;
      margin-block-end: 1.1rem;
    }

    .lede {
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--graphite);
      max-width: 48ch;
      margin: 0 0 1.8rem;
    }

    .hero-cta {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .hero-art {
      display: flex;
      justify-content: center;
    }

    .hero-art img {
      width: 100%;
      max-width: 26rem;
      height: auto;
    }

    /* Try -------------------------------------------------------------- */

    .try {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .try-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    @media (max-width: 52rem) {
      .try-inner {
        grid-template-columns: 1fr;
      }
    }

    .try-copy p {
      color: var(--graphite);
      max-width: 40ch;
    }

    .try-run :global(.source) {
      background: var(--paper);
    }

    .try-run .console {
      margin-block-start: 0.9rem;
    }

    /* Cards ------------------------------------------------------------ */

    .cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.25rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    }

    .card {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 1.5rem;
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius-lg);
      background: var(--paper);
    }

    .card h3 {
      font-size: var(--step-1);
    }

    .card p {
      margin: 0;
      color: var(--graphite);
      font-size: var(--step--1);
      flex: 1;
    }

    .card > a {
      font-weight: 600;
      font-size: var(--step--1);
      margin-block-start: 0.4rem;
    }

    .card .card-figure {
      font-size: var(--step-4);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--brand);
      flex: 0 !important;
    }

    .card .card-figure.mono {
      font-family: var(--font-mono);
      font-size: var(--step-1);
      font-weight: 600;
      letter-spacing: 0;
      padding-block: 0.4em;
    }

    .card-figure :global(.measure-value) {
      color: inherit;
      font-family: inherit;
      font-weight: inherit;
    }

    /* Measured --------------------------------------------------------- */

    .measured {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .measured :global(.stamped) {
      margin-block: 0.5rem 1.4rem;
    }

    .starts-cards .card {
      background: var(--raise);
      border-color: transparent;
    }
  </style>
</Page>
