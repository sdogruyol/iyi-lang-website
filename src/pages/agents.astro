---
/**
 * The agent claim, as a transcript.
 *
 * The site's first line says iyi is a language for people and their agents.
 * Every other claim here is measured or replayed; that one used to be four
 * paragraphs about verbs, and prose about a compiler is a claim about a
 * compiler rather than a reading of one. So this page shows the loop instead
 * of describing it, and shows nothing else.
 *
 * NOTHING ON THIS PAGE IS TYPED. Every command line is the argv
 * `scripts/record-agent.mjs` spawned, every body is the bytes that came back,
 * every exit code is the status the process gave, and the listing is
 * transcluded out of `records/agent/` with the compiler's own lexer colouring
 * it. The recorder refuses to write its record when a verb's verdict moves,
 * when `check` stops offering an edit, when a body-only change starts moving
 * an interface, or when the answer over MCP stops matching the answer in a
 * shell. So a page that renders is a page whose frames still hold.
 *
 * IT IS SHORT ON PURPOSE. The first draft explained each frame twice, once
 * before it and once after, and carried a second copy of the suggested edit as
 * a field list beside the JSON that already contained it. A transcript that
 * needs a paragraph per line is not evidence, it is an argument with exhibits.
 * One sentence per frame, and the frame says the rest.
 */
import Page from "../layouts/Page.astro";
import Frame from "../components/Frame.astro";
import Sample from "../components/Sample.astro";
import Stamped from "../components/Stamped.astro";
import Measure from "../components/Measure.astro";
import facts from "../generated/facts.json";
import record from "../../records/agent.json";
import thesis from "../generated/thesis.json";
import { SPELLED } from "../lib/lessons";

const base = import.meta.env.BASE_URL;
const pack = facts.recorded.context_pack;
const provenance = record.recorded;
const wire = record.wire;

/** Which stream a verb answers on. JSON gives it as a string; the component
 * takes only these two, and a record naming a third is a record this page
 * cannot render honestly. */
type Stream = "stdout" | "stderr";

const frames = Object.fromEntries(record.frames.map((f) => [f.id, f]));

/** A frame by id, with the stream it answered on narrowed. */
const frame = (id: string) => {
  const found = frames[id];
  if (!found) {
    throw new Error(
      `agents: records/agent.json has no frame "${id}". It has ` +
        `${record.frames.map((f) => f.id).join(", ")}. Re-record with ` +
        `"npm run record:agent" rather than dropping the frame from the page.`,
    );
  }
  if (found.payload !== "stdout" && found.payload !== "stderr") {
    throw new Error(
      `agents: frame "${id}" says it answers on "${found.payload}", and a ` +
        `recording of a process has two streams. Re-record.`,
    );
  }
  const payload = found.payload as Stream;
  return { ...found, payload, answer: found[payload] };
};

/** The consumer being edited, which is the only listing this page shows. */
const consumer = record.project.find((file) => file.name === "app.iyi");
if (!consumer) {
  throw new Error("agents: records/agent/app.iyi is not in the recording");
}
---

<Page
  kind="TechArticle"
  title="For agents, and for you"
  summary="iyi treats an agent as a first-class reader of code, beside the person writing it. AI_FIRST.md names four properties that takes, and two of them iyi holds by language rule rather than by tooling effort. Below is a recorded session: every frame a real run of the compiler's own verbs."
>
  <section class="hero">
    <div class="wrap">
      <p class="label">For agents, and for you</p>
      <h1>A language with two first-class readers.</h1>
      <p class="lede">
        Most languages were designed for one audience and grew tooling for the
        other. iyi treats an agent as a reader of code beside the person
        writing it, and that is a decision in the language rather than a layer
        over it: the rules that make a build read declarations instead of
        bodies are the rules that let a model read an interface without the
        repository.
      </p>
      <p class="lede">
        The design record states what that takes, and this page is the
        recording of it working.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>What it takes, and which of it is a rule</h2>
      <p class="sub">
        Four properties, in {thesis.provenance.source}'s own words. Numbers{" "}
        {thesis.held.numbers.join(" and ")} are marked because the record says
        iyi holds them {thesis.held.how}, and names{" "}
        {thesis.held.rules.map((rule, i) => (
          <>{i === 0 ? "" : i === thesis.held.rules.length - 1 ? " and " : ", "}<code>{rule}</code></>
        ))}{" "}
        as the rules that do it. The other two are tool surface, which is what
        the session below exercises.
      </p>
      <ol class="thesis">
        {
          thesis.properties.map((property) => (
            <li data-held={thesis.held.numbers.includes(property.number) ? "rule" : undefined}>
              <h3>{property.name}</h3>
              <p>{property.text}</p>
              {thesis.held.numbers.includes(property.number) && (
                <p class="held">held by rule</p>
              )}
            </li>
          ))
        }
      </ol>
      <p class="sub cite">
        {thesis.provenance.source} &sect; {thesis.provenance.section}, line{" "}
        {thesis.provenance.line}, at {thesis.provenance.commit}. Lifted by{" "}
        <code>{thesis.provenance.generator}</code>, not restated.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>The loop, recorded</h2>
      <p class="sub">
        An agent is handed {SPELLED[record.project.length]} modules with one
        mistake in them and takes them to green with the compiler's own verbs.
        Below is what those verbs answered, in the order they answered. The
        recorder refuses to publish a frame whose verdict moved, so a page that
        loads is a page whose session still runs.
      </p>
      <dl class="evidence hero-evidence">
        <dt>recorded by</dt>
        <dd>{provenance.compiler}</dd>
        <dt>on</dt>
        <dd>{provenance.machine}</dd>
        <dt>with</dt>
        <dd><code>{provenance.command}</code>, at {provenance.commit.slice(0, 9)}</dd>
      </dl>

      <p class="sub listing-lead">
        The file being edited, committed broken on purpose. Its dependency
        exports two functions and keeps a third to itself, which is why nothing
        below mentions the third.
      </p>
      <Sample path={consumer.path} />

      <ol class="loop">
        <li>
          <h3>Ground the edit</h3>
          <p>
            Every import's exported surface as data, with its doc comments and
            the <code>interface_hash</code> they are keyed by. No bodies, and
            read without compiling the file, so it is available while the
            program is still wrong.
          </p>
          <Frame
            command={frame("ground").command}
            body={frame("ground").answer}
            stream={frame("ground").payload}
            exitCode={frame("ground").exitCode}
            caption="the grounding pack"
          />
        </li>

        <li>
          <h3>Ask for the verdict</h3>
          <p>
            Each error is a record, and where the compiler knows the fix it
            carries <code>suggested_edit</code> with the exact span to replace.
            On <code>{frame("check").payload}</code>, because an error is an
            error whatever its format.
          </p>
          <Frame
            command={frame("check").command}
            body={frame("check").answer}
            stream={frame("check").payload}
            exitCode={frame("check").exitCode}
            caption="the compiler's verdict"
          />
        </li>

        <li>
          <h3>Apply it, and confirm</h3>
          <p>
            <code>fix</code> applies the compiler's own edits and recompiles
            after each, so no round is spent on a repair the compiler already
            knows. The confirmation prints nothing: the verdict is the exit
            code.
          </p>
          <Frame
            command={frame("fix").command}
            body={frame("fix").answer}
            stream={frame("fix").payload}
            exitCode={frame("fix").exitCode}
            caption="the repair"
          />
          <Frame
            command={frame("clean").command}
            body={frame("clean").answer}
            stream={frame("clean").payload}
            exitCode={frame("clean").exitCode}
            caption="green, and silent about it"
          />
        </li>

        <li>
          <h3>Re-run only what the change reaches</h3>
          <p>
            A test is affected exactly when the changed file is in its
            transitive import closure, parsed rather than compiled. So the skip
            is a fact and not an optimisation that might be wrong.
          </p>
          <div class="two">
            <Frame
              command={frame("affected-hit").command}
              body={frame("affected-hit").answer}
              stream={frame("affected-hit").payload}
              exitCode={frame("affected-hit").exitCode}
              caption="a module the test imports"
            />
            <Frame
              command={frame("affected-miss").command}
              body={frame("affected-miss").answer}
              stream={frame("affected-miss").payload}
              exitCode={frame("affected-miss").exitCode}
              caption="a module nothing imports"
            />
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Does the edit reach anyone?</h2>
      <p class="sub">
        The question an agent working in someone else's repository needs
        answered, and the one this language was shaped to make answerable. Two
        edits to the same file, one artifact each, read rather than rebuilt.
      </p>
      <div class="two">
        <Frame
          command={frame("diff-body").command}
          body={frame("diff-body").answer}
          stream={frame("diff-body").payload}
          exitCode={frame("diff-body").exitCode}
          caption="a body moved"
        />
        <Frame
          command={frame("diff-api").command}
          body={frame("diff-api").answer}
          stream={frame("diff-api").payload}
          exitCode={frame("diff-api").exitCode}
          caption="a declaration moved"
        />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>The same verbs, over the protocol</h2>
      <p class="sub">
        <code>iyi mcp</code> is a shell around the same binary, so there is no
        agent mode and no forked behaviour. It serves{" "}
        {wire.tools.map((tool) => <code>{tool}</code>)} over stdio. Same verb,
        same file, two doors:
      </p>
      <div class="two">
        <div class="console">
          <div class="console-chrome">
            <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
            <span class="caption">iyi check -f json app.iyi</span>
          </div>
          <pre><span class="out">{wire.shell}</span></pre>
        </div>
        <div class="console">
          <div class="console-chrome">
            <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
            <span class="caption">tools/call, name: check</span>
          </div>
          <pre><span class="out">{wire.mcp}</span></pre>
        </div>
      </div>
      <Stamped
        claim="Byte for byte the same answer through both doors."
        band="Compared on every recording, and the record is refused when they differ."
        subject="iyi check -f json in a shell, against the check tool over MCP stdio"
        machine={provenance.machine}
        command={provenance.command}
        outcome="win"
      >
        <dl class="evidence">
          <dt>identical</dt>
          <dd>{String(wire.identical)}</dd>
          <dt>bytes</dt>
          <dd>{wire.bytes}</dd>
        </dl>
      </Stamped>
      <p class="sub">
        Each tool's schema and the client configuration are on the{" "}
        <a href={`${base}tools/mcp/`}>MCP page</a>.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>What it costs</h2>
      <p class="sub">
        On {SPELLED[record.project.length]} modules a pack is no smaller than
        the sources it stands in for. The saving is a property of scale, so it
        is measured where scale exists: the repository's own{" "}
        <Measure of="generated" />-line project of <Measure of="modules" />{" "}
        modules, by a gate that runs both arms.
      </p>
      <Stamped
        claim={`${pack.tokens_low} to ${pack.tokens_high}% fewer prompt tokens, for no fewer rounds.`}
        band={`The pack is ${pack.size_low} to ${pack.size_high}% of the size of the sources it replaces, over ${pack.runs} measured runs.`}
        subject={pack.subject}
        machine={pack.machine}
        command={pack.command}
        outcome="win"
      >
        <p class="wire-note">
          Rounds to green were the model's, and they were tied{" "}
          {pack.rounds_tied} times and lost {pack.rounds_lost} times.
        </p>
      </Stamped>
      <p class="sub run-it">
        The project is <code>records/agent/</code> in this site's repository and
        the commands are the ones above.{" "}
        <a href={`${base}install/`}>Install the compiler</a> and the frames on
        this page are what you will see.
      </p>
    </div>
  </section>

  <style>
    section {
      padding-block: clamp(2.5rem, 5vw, 4.5rem);
    }

    section h2 {
      font-size: var(--step-3);
      margin-block-end: 0.6rem;
    }

    section h3 {
      font-size: var(--step-1);
      margin-block: 0 0.4rem;
    }

    .band {
      background: var(--raise);
      border-block: var(--hair) solid var(--hairline);
    }

    .label {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brand-deep);
      margin-block-end: 0.6rem;
    }

    .sub {
      color: var(--graphite);
      max-width: 68ch;
      margin-block-end: 1.4rem;
      font-size: var(--step-0);
    }

    .hero h1 {
      font-size: var(--step-4);
      max-width: 34ch;
      margin-block-end: 1rem;
    }

    .hero .lede {
      font-size: var(--step-1);
      color: var(--graphite);
      max-width: 62ch;
    }

    .hero-evidence {
      margin-block-start: 2rem;
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.3rem 1.2rem;
      max-width: 62ch;
    }

    .hero-evidence dd {
      margin: 0;
      color: var(--graphite);
    }

    /* The four properties, numbered by the record rather than by the list, so
     * the numbers on the page are the numbers the sentence below them cites.
     * The two held by rule carry the accent edge; the other two do not, which
     * is the page saying which half is a language and which half is tooling. */
    .thesis {
      list-style: none;
      margin: 0 0 1.4rem;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      gap: 1rem;
      counter-reset: property;
    }

    .thesis > li {
      counter-increment: property;
      padding: 1.1rem 1.2rem;
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius);
      background: var(--paper);
    }

    .thesis > li[data-held="rule"] {
      border-color: var(--brand);
    }

    .thesis h3::before {
      content: counter(property) ". ";
      color: var(--mute);
      font-family: var(--font-mono);
      font-weight: 400;
    }

    .thesis p {
      color: var(--graphite);
      font-size: var(--step--1);
      margin: 0;
    }

    .thesis .held {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--brand-deep);
      margin-block-start: 0.6rem;
    }

    .cite {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
      margin-block-end: 0;
    }

    .listing-lead {
      margin-block-start: 2rem;
    }

    /* The loop, numbered, because the order is the argument. The marker is
     * the step and the heading is what the step does, so a reader skimming the
     * numbers gets the shape before any output. */
    .loop {
      list-style: none;
      counter-reset: step;
      margin: 2rem 0 0;
      padding: 0;
      display: grid;
      gap: 2.5rem;
    }

    .loop > li {
      counter-increment: step;
      display: grid;
      gap: 0.4rem;
    }

    .loop > li > h3::before {
      content: counter(step) ". ";
      color: var(--mute);
      font-family: var(--font-mono);
      font-weight: 400;
    }

    .loop p {
      color: var(--graphite);
      max-width: 68ch;
      font-size: var(--step--1);
      margin-block-end: 0.8rem;
    }

    .two {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      gap: 1.25rem;
    }

    .wire-note {
      color: var(--graphite);
      font-size: var(--step--1);
      max-width: 62ch;
      margin-block: 0 0.8rem;
    }

    .run-it {
      margin-block-start: 1.6rem;
      margin-block-end: 0;
    }
  </style>
</Page>
