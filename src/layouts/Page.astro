---
// Fonts are vendored, never fetched from a CDN. A site arguing that a program
// should link what it uses does not get to pull webfonts off a third party.
import "@fontsource-variable/figtree/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/ibm-plex-mono/400-italic.css";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/code.css";

import facts from "../generated/facts.json";

interface Props {
  title: string;
  summary?: string;
}

const { title, summary } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;
const here = Astro.url.pathname;

const nav = [
  ["Why iyi", "why/"],
  ["Learn", "learn/"],
  ["Spec", "spec/"],
  ["Playground", "playground/"],
  ["Changelog", "changelog/"],
];

const current = (path: string) => here.startsWith(href(path));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {summary && <meta name="description" content={summary} />}
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    {summary && <meta property="og:description" content={summary} />}
    <meta property="og:image" content={new URL(href("mascot.webp"), Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="wordmark" href={href("/")} aria-label="iyi, home">
          <img src={href("mascot.webp")} alt="" width="28" height="26" />
          <span>iyi</span>
        </a>
        <nav aria-label="Sections">
          <ul>
            {
              nav.map(([label, path]) => (
                <li>
                  <a href={href(path)} aria-current={current(path) ? "page" : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
            <li class="nav-github">
              <a href="https://github.com/sdogruyol/iyi">GitHub</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="wrap colophon-inner">
        <div class="colophon-brand">
          <img src={href("mascot.webp")} alt="The iyi mascot, a waving heart" width="72" height="68" />
          <p>
            iyi is Turkish for good. The compiler is built on Crystal's and
            carries its licence and copyright: Apache 2.0, Copyright 2012-2026
            Manas Technology Solutions.
          </p>
        </div>
        <nav class="colophon-links" aria-label="Footer">
          <ul>
            {
              nav.map(([label, path]) => (
                <li>
                  <a href={href(path)}>{label}</a>
                </li>
              ))
            }
            <li><a href="https://github.com/sdogruyol/iyi">Source on GitHub</a></li>
          </ul>
        </nav>
        <dl class="evidence colophon-evidence">
          <dt>numbers on this site</dt>
          <dd>generated by {facts.provenance.generator}</dd>
          <dt>measured at</dt>
          <dd>{facts.provenance.commit}</dd>
        </dl>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: var(--edge);
        top: var(--edge);
        background: var(--raise);
        padding: 0.5rem 0.8rem;
        border: var(--hair) solid var(--ink);
        z-index: 10;
      }

      .masthead {
        border-bottom: var(--hair) solid var(--hairline);
        background: var(--paper);
      }

      .masthead-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        min-height: 3.75rem;
        flex-wrap: wrap;
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--ink);
      }

      .wordmark:hover {
        text-decoration: none;
      }

      .wordmark img {
        display: block;
        height: 1.65rem;
        width: auto;
      }

      nav ul {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
        align-items: center;
      }

      .masthead nav a {
        display: inline-block;
        padding: 0.45rem 0.7rem;
        border-radius: 6px;
        font-size: var(--step--1);
        font-weight: 500;
        color: var(--graphite);
        text-decoration: none;
      }

      .masthead nav a:hover {
        color: var(--ink);
        background: var(--raise);
      }

      .masthead nav a[aria-current="page"] {
        color: var(--brand-deep);
      }

      .nav-github {
        margin-inline-start: 0.5rem;
      }

      .nav-github a {
        border: var(--hair) solid var(--hairline);
      }

      .colophon {
        margin-block-start: 5rem;
        padding-block: 2.5rem 3rem;
        border-top: var(--hair) solid var(--hairline);
        background: var(--raise);
      }

      .colophon-inner {
        display: grid;
        gap: 2.5rem;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1fr);
        align-items: start;
      }

      @media (max-width: 52rem) {
        .colophon-inner {
          grid-template-columns: 1fr;
        }
      }

      .colophon-brand {
        display: flex;
        gap: 1.1rem;
        align-items: flex-start;
      }

      .colophon-brand img {
        flex: none;
        width: 4.5rem;
        height: auto;
      }

      .colophon-brand p {
        font-size: var(--step--1);
        color: var(--graphite);
        max-width: 42ch;
        margin: 0;
      }

      .colophon-links ul {
        flex-direction: column;
        gap: 0.35rem;
      }

      .colophon-links a {
        font-size: var(--step--1);
        color: var(--graphite);
      }

      .colophon-links a:hover {
        color: var(--ink);
      }

      .colophon-evidence {
        margin: 0;
      }
    </style>
  </body>
</html>
