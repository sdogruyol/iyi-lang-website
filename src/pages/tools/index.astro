---
/**
 * The index over the three tool surfaces. Every count on it is read from the
 * generated record behind the page it points at, so a card cannot promise a
 * page's contents and be wrong about them.
 */
import Page from "../../layouts/Page.astro";
import cli from "../../../records/cli.json";
import editors from "../../generated/editors.json";
import mcp from "../../generated/mcp.json";

const base = import.meta.env.BASE_URL;

const surfaces = [
  {
    href: `${base}tools/cli/`,
    title: "The command line",
    count: `${cli.verbs.length} verbs`,
    what:
      "Every subcommand and what it prints for --help, recorded from the " +
      "compiler rather than written down.",
  },
  {
    href: `${base}tools/editor/`,
    title: "Editors",
    count: `${editors.clients.length} clients`,
    what:
      "One command, no grammar file. The stanzas for VS Code, Neovim, Helix, " +
      "Sublime Text and Zed, quoted from the repository's editors guide.",
  },
  {
    href: `${base}tools/mcp/`,
    title: "MCP tools",
    count: `${mcp.tools.length} tools`,
    what:
      "The compiler's verbs as Model Context Protocol tools over stdio, with " +
      "the catalogue a harness reads at tools/list.",
  },
];

const elsewhere = [
  [`${base}agents/`, "The recorded agent loop"],
  [`${base}playground/`, "The playground"],
  [`${base}download/`, "Downloads and checksums"],
  [`${base}targets/`, "Platforms, and what CI proves"],
];
---

<Page
  kind="CollectionPage"
  title="Tools"
  summary="The command line, the language server, and the MCP tool catalogue. Every verb, stanza and schema on these pages is read out of the compiler's own tree or recorded from the binary."
>
  <section class="wrap head">
    <p class="label">Tools</p>
    <h1>The tools are the compiler.</h1>
    <p class="lede">
      There is no second implementation anywhere in here. Your editor, an agent
      harness and a shell all reach the same front end, so a build,{" "}
      <code>iyi check</code> and the underline in your editor cannot disagree
      about what is clean. These three pages are what each of them sees.
    </p>
  </section>

  <section class="wrap">
    <ul class="cards">
      {surfaces.map((surface) => (
        <li>
          <a href={surface.href}>
            <span class="count">{surface.count}</span>
            <h2>{surface.title}</h2>
            <p>{surface.what}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap next">
    <h2>Elsewhere</h2>
    <ul class="links">
      {elsewhere.map(([href, label]) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </section>

  <style>
    section {
      padding-block: clamp(1.2rem, 2.5vw, 2rem);
    }

    .head {
      padding-block-start: clamp(2.5rem, 5vw, 4rem);
    }

    .head h1 {
      font-size: var(--step-4);
      margin-block: 0.5rem 0.8rem;
    }

    .lede {
      color: var(--graphite);
      max-width: 62ch;
    }

    .cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: 1rem;
    }

    .cards a {
      display: block;
      height: 100%;
      padding: 1.1rem 1.2rem;
      border: var(--hair) solid var(--hairline);
      border-radius: 2px;
      color: inherit;
      text-decoration: none;
      background: var(--raise);
    }

    .cards a:hover {
      border-color: var(--graphite);
    }

    .count {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brand);
    }

    .cards h2 {
      font-size: var(--step-1);
      margin-block: 0.3rem 0.4rem;
    }

    .cards p {
      color: var(--graphite);
      margin: 0;
      font-size: var(--step--1);
    }

    .next h2 {
      font-size: var(--step-1);
      margin-block-end: 0.5rem;
    }

    .links {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.4rem;
    }

    .next {
      padding-block-end: 3rem;
    }
  </style>
</Page>
