---
/**
 * The playground's front door: the tour, as a table of contents.
 *
 * Short programs, this site's own, in sections, each of which runs in the
 * visitor's tab from the module the compiler built for it, or, where the
 * browser's target has no way to run it, shows what it printed natively. The
 * page says that in one line, lists the steps, and gets out of the way. What
 * the playground does not do, compile what a visitor types, is said once
 * under the list rather than argued; the full account is on the evidence page.
 *
 * PROGRESS IS A FACT ABOUT THIS BROWSER, so it is rendered by this browser.
 * The static HTML marks nothing: a page built in node cannot know which steps
 * a reader has opened, and a tick rendered at build time would be a claim
 * about somebody it has never met. The island reads
 * `src/playground/progress.ts`, which reads local storage, and marks the list
 * afterwards. One state, and it claims nothing more than it knows: opened.
 */
import Page from "../../layouts/Page.astro";
import { runnable, tourSamples, tourSections } from "../../playground/samples";
import { recordedText } from "../../lib/highlight";
import { SPELLED, lessonHref, sequence } from "../../lib/lessons";

const base = import.meta.env.BASE_URL.replace(/\/*$/, "/");
const lessons = await sequence();
const firstLesson = lessons[0];
const first = tourSamples[0];

/* Each program's first line is a comment saying what it is; the list shows
 * that line, so the description cannot drift from the file. */
const blurbOf = (path: string) =>
  recordedText(path).split("\n")[0].replace(/^#\s*/, "");

let n = 0;
const sections = tourSections.map((section) => ({
  title: section.title,
  blurb: section.blurb,
  steps: section.steps.map((step) => ({
    n: ++n,
    id: step.id,
    href: `${base}playground/${step.id}/`,
    blurb: blurbOf(step.path),
    runs: runnable(step),
  })),
}));
---

<Page
  kind="CollectionPage"
  title="A tour of iyi, in the playground"
  summary={`A tour of iyi in ${tourSamples.length} short programs, each of which runs in your browser. Read one, press Run, see what it prints.`}
>
  <section class="wrap head">
    <p class="label">Playground</p>
    <h1>A tour of iyi, in {tourSamples.length} short programs.</h1>
    <p class="one-line">
      Start at the top and work down. Read the program, press Run, see what it
      prints, then move to the next. Each one is a page you can come back to.
    </p>
    <a class="cta" href={`${base}playground/${first.id}/`}>Start with {first.id}</a>

    {/* Empty in the HTML on purpose. Whatever it says is a fact about this
        browser's own storage, so this browser says it or nobody does. */}
    <p class="progress" data-role="progress" hidden></p>
    <button type="button" class="cta ghost forget" data-role="forget" hidden>
      Forget my progress
    </button>
  </section>

  <section class="wrap">
    {
      sections.map((section) => (
        <div class="group">
          <h2>{section.title}</h2>
          <p class="group-blurb">{section.blurb}</p>
          <ol class="steps">
            {section.steps.map((step) => (
              <li>
                <a class="step" href={step.href} data-step={step.id}>
                  <span class="step-index">{step.n}</span>
                  <span class="step-id">{step.id}</span>
                  <span class="step-blurb">{step.blurb}</span>
                  {!step.runs && <span class="step-native">recorded</span>}
                  {/* Filled in by the island, and empty until then. */}
                  <span class="step-state" data-role="state"></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  <section class="wrap after">
    <p>
      Done with the tour? <a href={lessonHref(base, firstLesson)}>Learn the
      one rule</a> that makes iyi its own language, in {SPELLED[lessons.length]}
      {" "}lessons that each run a real program from the repository.
    </p>
    <p class="honest">
      Each program runs from the module the iyi compiler built for it, checked
      against its recording before it starts. A step marked recorded uses tasks,
      which the browser's target cannot run yet, so it shows what the program
      printed natively instead. You can type in any of the panes, and the page
      says which bytes a run will use the moment what is in one stops being the
      recorded file, because nothing on these pages compiles what you type.{" "}
      <a href={`${base}playground/evidence/`}>How this works</a>
    </p>
  </section>

  <script>
    /**
     * The marks on the list, which exist only in this browser.
     *
     * One state and no bar: a bar implies a distance, and what is worth
     * knowing here is which steps have been opened. The store is the same one
     * the sample pages write, `src/playground/progress.ts`, and it is the
     * whole of this island's imports: no record reaches this page.
     */
    import { clearProgress, readProgress, type TourProgress } from "../../playground/progress";

    (() => {
      const line = document.querySelector<HTMLElement>('[data-role="progress"]');
      const forget = document.querySelector<HTMLButtonElement>('[data-role="forget"]');
      const steps = [...document.querySelectorAll<HTMLAnchorElement>(".step[data-step]")];
      if (line === null || forget === null || steps.length === 0) return;

      const paint = (progress: TourProgress) => {
        const visited = new Set(progress.visited);

        for (const step of steps) {
          const mark = step.querySelector<HTMLElement>('[data-role="state"]');
          if (visited.has(step.dataset.step ?? "")) {
            step.dataset.state = "opened";
            /* The word rather than a symbol: an icon that means "done" is a
             * convention a reader has to already know, and there is room. */
            if (mark) mark.textContent = "opened";
          } else {
            delete step.dataset.state;
            if (mark) mark.textContent = "";
          }
        }

        const opened = steps.filter((step) => visited.has(step.dataset.step ?? "")).length;
        line.hidden = opened === 0;
        forget.hidden = opened === 0;
        line.textContent = `${opened} of ${steps.length} opened on this machine.`;
      };

      paint(readProgress());

      forget.addEventListener("click", () => {
        clearProgress();
        paint({ visited: [] });
      });
    })();
  </script>

  <style>
    .head {
      padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
    }

    .head h1 {
      font-size: var(--step-4);
      max-width: 22ch;
      margin-block: 0.5rem 0.8rem;
    }

    .one-line {
      color: var(--graphite);
      max-width: 52ch;
      margin-block-end: 1.4rem;
    }

    .group {
      margin-block-start: 2.5rem;
      max-width: 44rem;
    }

    .group h2 {
      font-size: var(--step-2);
      margin-block-end: 0.2rem;
    }

    .group-blurb {
      color: var(--graphite);
      margin-block-end: 0.9rem;
    }

    .steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.5rem;
    }

    .step {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr) auto auto;
      align-items: baseline;
      gap: 1rem;
      padding: 0.7rem 1.1rem;
      border: var(--hair) solid var(--hairline);
      border-radius: var(--radius);
      color: var(--ink);
      text-decoration: none;
    }

    .step:hover {
      border-color: var(--graphite);
      text-decoration: none;
    }

    .step-index {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
      min-width: 2ch;
      text-align: right;
    }

    .step-id {
      font-family: var(--font-mono);
      font-weight: 600;
      color: var(--brand-deep);
    }

    .step-blurb {
      color: var(--graphite);
      font-size: var(--step--1);
    }

    .step-native {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* The mark this browser put on a step. Empty, and therefore invisible,
     * until the island fills it, because the built page knows nothing about
     * any reader. */
    .step-state {
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--mute);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* A left edge on a step that has been opened, in the gutter rather than
     * around the row, so the list still reads as one list. */
    .step[data-state] {
      border-inline-start: 2px solid var(--track);
    }

    .progress {
      margin-block: 1.2rem 0.6rem;
      font-family: var(--font-mono);
      font-size: var(--step--2);
      color: var(--graphite);
    }

    .forget {
      font-size: var(--step--2);
      padding: 0.35rem 0.7rem;
      cursor: pointer;
    }

    @media (max-width: 40rem) {
      .step {
        grid-template-columns: auto minmax(0, 1fr);
      }
      .step-blurb,
      .step-native,
      .step-state {
        grid-column: 2;
      }
    }

    .after {
      margin-block-start: 3rem;
      max-width: var(--measure);
    }

    .honest {
      color: var(--graphite);
      font-size: var(--step--1);
    }
  </style>
</Page>
