---
/**
 * The page for an address that names nothing.
 *
 * `indexable={false}`, which is Page.astro's prop for a robots noindex. A 404
 * here is served at whatever address was asked for, so to a crawler it is
 * otherwise indistinguishable from a real page and would be indexed as a
 * self-canonical dead end.
 */
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import mascot from "../assets/mascot.png";

const base = import.meta.env.BASE_URL;
---

<Page title="Not found" summary="There is no page at this address." indexable={false}>
  <section class="wrap lost">
    <Image src={mascot} alt="" width={160} height={150} densities={[1, 2]} loading="lazy" decoding="async" />
    <div>
      <p class="label">404</p>
      <h1>Nothing here.</h1>
      <p>
        The address does not name a page on this site. The tour and the
        lessons are where most things live.
      </p>
      <div class="hero-cta">
        <a class="cta" href={base}>Home</a>
        <a class="cta ghost" href={`${base}playground/`}>Take the tour</a>
      </div>
    </div>
  </section>

  <style>
    .lost {
      display: flex;
      gap: 2.5rem;
      align-items: center;
      padding-block: clamp(3rem, 8vw, 6rem);
      flex-wrap: wrap;
    }

    .lost img {
      width: 10rem;
      height: auto;
    }

    .lost h1 {
      font-size: var(--step-4);
      margin-block: 0.3rem 0.8rem;
    }

    .lost p {
      color: var(--graphite);
      max-width: 44ch;
    }

    .hero-cta {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin-block-start: 1.2rem;
    }
  </style>
</Page>
